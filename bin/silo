#!/usr/bin/env -S python3 -I
"""silo: everyday commands for a Migrations node.

  silo doctor                      check everything the node needs; print exact fixes
  silo update [--branch BRANCH]    (root) pull the installer, update the release, restart, doctor
  silo use-github                  (root) take silo-migrate updates from GitHub, not copied bundles
  silo restart                     restart the term-llm web service
  silo shell                       (root) a service-account shell with the right environment
  silo prime                       sign in to 1Password and warm op-cache for Frontier (24 h)
  silo claude-login [--sso|--console]   sign the service account in to Claude Code
  silo intake PROJECT              prepare the drop folder for a project's export files

Run as root or as the service account; account steps always run as the service account.
"""
import json
import os
from pathlib import Path
import pwd
import re
import shutil
import stat
import subprocess
import sys
import time

SELF = Path(__file__).resolve()
RELEASE = SELF.parent.parent
PREFIX = RELEASE.parent.parent if RELEASE.parent.name == "releases" else Path(os.environ.get("SILO_PREFIX", "/srv/silo-migrate"))
METAL_CONFIG = Path(os.environ.get("SILO_METAL_CONFIG", "/etc/silo-migrate/metal.conf"))
INSTALLER = Path(os.environ.get("SILO_INSTALLER", "/opt/silo-migrate-installer"))
GITHUB_SILO = "https://github.com/RubenOussoren/silo-migrate.git"
PROJECT = re.compile(r"[a-zA-Z0-9][a-zA-Z0-9_-]{0,62}\Z")
REPO = re.compile(r"https://[A-Za-z0-9.-]+/[A-Za-z0-9_./-]+\Z")
OP_REF = re.compile(r'op-cache read "(op://[^"]+)"(?:\s+--account\s+([A-Za-z0-9._-]+))?')


class Stop(Exception):
    pass


def account():
    for candidate in (PREFIX / "releases", PREFIX):
        try:
            return pwd.getpwuid(candidate.stat().st_uid)
        except (OSError, KeyError):
            continue
    try:
        return pwd.getpwnam("silomig")
    except KeyError:
        raise Stop("no installation at " + str(PREFIX) + " and no silomig account")


def is_root():
    return os.geteuid() == 0


def account_env(entry):
    run = "/run/user/" + str(entry.pw_uid)
    return {"HOME": entry.pw_dir, "USER": entry.pw_name, "LOGNAME": entry.pw_name, "SHELL": "/bin/bash",
            "PATH": str(PREFIX / "bin") + ":/usr/local/bin:/usr/bin:/bin", "LANG": "C.UTF-8", "TMPDIR": str(PREFIX / "state/tmp"),
            "XDG_RUNTIME_DIR": run, "DBUS_SESSION_BUS_ADDRESS": "unix:path=" + run + "/bus",
            **({"TERM": os.environ["TERM"]} if os.environ.get("TERM") else {})}


def as_account(argv, entry=None):
    """argv to run as the service account with its environment, from root or the account."""
    entry = entry or account()
    env = account_env(entry)
    if os.geteuid() == entry.pw_uid:
        return ["env", "-i", *[k + "=" + v for k, v in env.items()], *argv]
    if not is_root():
        raise Stop("run this as root or as " + entry.pw_name)
    return ["sudo", "-u", entry.pw_name, "--", "env", "-i", *[k + "=" + v for k, v in env.items()], *argv]


def run(argv, timeout=60, input=None):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=timeout, input=input, stdin=None if input is not None else subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as error:
        return subprocess.CompletedProcess(argv, 124, "", str(error))


def term_llm():
    return str(PREFIX / "bin/term-llm")


def need_root(what):
    if not is_root():
        raise Stop(what + " needs root")


# -- doctor --------------------------------------------------------------------------

def read_conf(path=None):
    values = {}
    for line in (path or METAL_CONFIG).read_text().splitlines():
        if line and not line.startswith("#") and "=" in line:
            key, _, value = line.partition("=")
            values[key] = value
    return values


def shipped_agents(release):
    return sorted(path.parent.name for path in (Path(release) / "integrations/term-llm").glob("*/agent.yaml"))


def listed_agents(text):
    names = re.findall(r"(?m)^\s{4}([a-z][a-z0-9-]*) - ", text or "")
    count = re.search(r"Available agents \((\d+)\)", text or "")
    return (int(count[1]) if count else 0), sorted(names), "[builtin]" in (text or "")


def config_ref(entry):
    try:
        text = (Path(entry.pw_dir) / ".config/term-llm/config.yaml").read_text()
    except OSError:
        return None, None, ""
    match = OP_REF.search(text)
    return (match[1], match[2], text) if match else (None, None, text)


def op_cache_settings(entry):
    """(config present, socket path, ttl seconds) for the account's op-cache; defaults if absent."""
    path = Path(entry.pw_dir) / ".config/op-cache/config.yaml"
    values = {}
    try:
        for line in path.read_text().splitlines():
            key, _, value = line.partition(":")
            values[key.strip()] = value.strip().strip("\"'")
        present = True
    except (OSError, UnicodeDecodeError):
        present = False
    try:
        ttl = int(values.get("ttl_seconds", "86400"))
    except ValueError:
        ttl = 86400
    return present, values.get("socket_path", "/tmp/op-cache.sock"), ttl


def duration(seconds):
    days, hours = seconds // 86400, seconds // 3600
    return ("%d days" % days) if seconds >= 2 * 86400 else ("%d hours" % hours) if seconds >= 7200 else ("%d minutes" % (seconds // 60))


def private_file(path, uid):
    try:
        info = os.lstat(path)
    except OSError:
        return None
    return stat.S_ISREG(info.st_mode) and info.st_uid == uid and not info.st_mode & 0o077


# The first term-llm release that enforces `agents:` in mcp.json (SamSaffron/term-llm#1332);
# None until one is pinned. Older releases ignore the field, so any chat can turn DBHub on.
MCP_AGENTS_SINCE = None


def term_llm_version(entry, runner):
    match = re.search(r"version (\d+)\.(\d+)\.(\d+)", runner(as_account([term_llm(), "version"], entry), timeout=30).stdout or "")
    return tuple(int(part) for part in match.groups()) if match else None


def dbhub_check(add, entry, runner):
    """Projects' DBHub servers (db-<project>) must be limited to migration-data, and term-llm must enforce it.
    Only counts are printed: project names can identify customers."""
    try:
        servers = json.loads((Path(entry.pw_dir) / ".config/term-llm/mcp.json").read_text()).get("servers") or {}
    except FileNotFoundError:
        servers = {}
    except (OSError, ValueError, AttributeError):
        add("WARN", "DBHub", "~/.config/term-llm/mcp.json can't be read")
        return
    ours = {name: server for name, server in servers.items() if name.startswith("db-") and isinstance(server, dict) and (server.get("args") or [None])[0] == "dbhub"}
    if not ours:
        add("OK", "DBHub", "no project database servers yet")
        return
    open_ = sum(1 for server in ours.values() if server.get("agents") != ["migration-data"])
    if open_:
        add("WARN", "DBHub", "%d of %d project servers not limited to migration-data" % (open_, len(ours)),
            "in a migration-data chat for each project, run data_db_status (it puts the limit back)")
        return
    version = term_llm_version(entry, runner)
    enforced = bool(MCP_AGENTS_SINCE and version and version >= MCP_AGENTS_SINCE)
    add("OK" if enforced else "WARN", "DBHub", "%d project servers, limited to migration-data" % len(ours) + ("" if enforced else
        "; term-llm %s doesn't enforce the limit yet: turn db-* servers on only in migration-data chats" % (".".join(map(str, version)) if version else "?")),
        None if enforced else "update term-llm once a release includes SamSaffron/term-llm#1332")


def doctor_checks(entry, runner=run):
    checks = []

    def add(status, name, detail, fix=None):
        checks.append({"status": status, "name": name, "detail": detail, "fix": fix})

    current = (PREFIX / "current").resolve()
    add("OK" if current.is_dir() else "FAIL", "release", "current = " + current.name[:12] if current.is_dir() else "no current release",
        None if current.is_dir() else "install with the installer's metal plan/apply")
    if is_root():
        head = runner(["git", "-C", str(INSTALLER), "rev-parse", "HEAD"]).stdout.strip()
        if head:
            same = head == current.name
            add("OK" if same else "WARN", "installer checkout", head[:12] + (" (matches release)" if same else " (differs from the release)"),
                None if same else "silo update")
        else:
            add("WARN", "installer checkout", "can't read " + str(INSTALLER) + " (missing, or not owned by root)")
        try:
            conf = read_conf()
            local = conf.get("SILO_REPO", "").startswith("/")
            add("WARN" if local else "OK", "update source", "local copy: updates need bundles" if local else "GitHub", "silo use-github" if local else None)
        except (OSError, UnicodeDecodeError):
            add("WARN", "update source", "can't read " + str(METAL_CONFIG))
        link = Path("/usr/local/bin/silo")
        good = link.is_symlink() and os.readlink(link) == str(PREFIX / "current/bin/silo")
        add("OK" if good else "WARN", "silo command", "/usr/local/bin/silo" + (" links to the current release" if good else " is missing"),
            None if good else "ln -sfn " + str(PREFIX / "current/bin/silo") + " /usr/local/bin/silo")
    else:
        add("WARN", "root checks", "skipped: run as root for installer, update-source and link checks")

    status = runner(as_account([term_llm(), "service", "status"], entry), timeout=30)
    active = "ActiveState=active" in status.stdout
    add("OK" if active else "FAIL", "web service", "active" if active else "not active", None if active else "silo restart")

    expected = shipped_agents(current)
    count, names, builtin = listed_agents(runner(as_account([term_llm(), "agents"], entry), timeout=30).stdout)
    good = not builtin and count == len(expected) and names == expected
    add("OK" if good else "FAIL", "agents", (str(count) + " listed: " + ", ".join(names)) if names else "none listed",
        None if good else "check agents.use_builtin: false and agents.search_paths in ~/.config/term-llm/config.yaml, then silo restart")

    home = Path(entry.pw_dir)
    shipped_skills = current / "integrations/term-llm/skills"
    if shipped_skills.is_dir():
        link, target = home / ".config/term-llm/skills", str(PREFIX / "current/integrations/term-llm/skills")
        linked = link.is_symlink() and os.readlink(link) == target
        count = sum(1 for path in shipped_skills.glob("*/SKILL.md"))
        add("OK" if linked else "WARN", "skills", ("%d linked from the release" % count) if linked else str(link) + " is not linked to the release",
            None if linked else "move any existing " + str(link) + " aside, then as the service account: ln -s " + target + " " + str(link) + "; silo restart")

    dbhub_check(add, entry, runner)

    chatgpt = (home / ".config/term-llm/chatgpt_oauth.json").is_file()
    add("OK" if chatgpt else "FAIL", "ChatGPT sign-in", "credential present" if chatgpt else "not signed in",
        None if chatgpt else "silo shell, then: term-llm auth login chatgpt")

    present, socket, ttl = op_cache_settings(entry)
    shared = socket.startswith("/tmp/")
    add("OK" if present and not shared else "WARN", "op-cache config",
        ("socket " + socket + ", cache " + duration(ttl)) if present else "missing: defaults (socket in shared /tmp, 24 hours)",
        None if present and not shared else "give the account a config with socket_path under /run/user/" + str(entry.pw_uid) + " (see docs/node-operations.md)")
    reference, op_account, config_text = config_ref(entry)
    if reference:
        quiet = ["sh", "-c", 'exec op-cache read "$@" >/dev/null 2>&1', "sh", reference, *(["--account", op_account] if op_account else [])]
        primed = runner(as_account(quiet, entry), timeout=20).returncode == 0
        add("OK" if primed else "FAIL", "Frontier (op-cache)", "cache primed" if primed else "not primed or expired (24 h)", None if primed else "silo prime")
    else:
        add("WARN", "Frontier (op-cache)", "no op-cache reference in the term-llm config")

    if "claude-bin:" in config_text:
        claude = shutil.which("claude", path=str(PREFIX / "bin") + ":/usr/local/bin")
        if not claude:
            add("FAIL", "Claude (claude-bin)", "claude not on the web service's PATH", "silo claude-login")
        else:
            out = runner(as_account([claude, "auth", "status", "--json"], entry), timeout=30).stdout
            try:
                logged = bool(json.loads(out).get("loggedIn"))
            except ValueError:
                logged = False
            add("OK" if logged else "FAIL", "Claude (claude-bin)", "signed in" if logged else "not signed in", None if logged else "silo claude-login")
    else:
        add("WARN", "Claude (claude-bin)", "not configured: converter-reviewer needs it")

    tokens = sorted((home / ".config/silo-migrate/github").glob("token-*"))
    unsafe = [path.name for path in tokens if not private_file(path, entry.pw_uid)]
    add("FAIL" if unsafe else ("OK" if tokens else "WARN"), "GitHub token",
        ("not private: " + ", ".join(unsafe)) if unsafe else (", ".join(path.name for path in tokens) if tokens else "none: pushes and private converter clones need one"),
        ("chmod 600 " + " ".join(str(home / ".config/silo-migrate/github" / name) for name in unsafe)) if unsafe else None)
    identity = (home / ".config/silo-migrate/git-identity").is_file()
    add("OK" if identity else "WARN", "commit identity", "set" if identity else "missing: converter-developer can't commit",
        None if identity else "printf 'name=…\\nemail=…\\n' > ~/.config/silo-migrate/git-identity (as the service account)")

    docker = runner(as_account(["docker", "info", "--format", "{{.ServerVersion}}"], entry), timeout=30)
    add("OK" if docker.returncode == 0 else "FAIL", "Docker", ("server " + docker.stdout.strip()) if docker.returncode == 0 else "unreachable for the service account")

    try:
        free = shutil.disk_usage(PREFIX).free / 1024**3
        add("OK" if free >= 50 else "WARN", "disk", "%.0f GiB free on %s" % (free, PREFIX))
    except OSError:
        add("FAIL", "disk", str(PREFIX) + " missing")

    writable = 0
    if current.is_dir():
        for directory, _dirs, files in os.walk(current):
            writable += sum(1 for name in files if not os.path.islink(os.path.join(directory, name)) and os.lstat(os.path.join(directory, name)).st_mode & 0o222)
            if writable:
                break
    add("OK" if not writable else "WARN", "release read-only", "sealed" if not writable else "writable files in the current release", None if not writable else "silo update")
    return checks


def doctor(entry):
    checks = doctor_checks(entry)
    for check in checks:
        print("%-4s %-20s %s" % (check["status"], check["name"], check["detail"]))
        if check["fix"]:
            print("     fix: " + check["fix"])
    failed = sum(1 for check in checks if check["status"] == "FAIL")
    warned = sum(1 for check in checks if check["status"] == "WARN")
    print("\n%d failed, %d warnings" % (failed, warned))
    return 1 if failed else 0


# -- actions ---------------------------------------------------------------------------

def shown(argv):
    """The command as a person would type it: without sudo/env prefixes and variables."""
    rest = list(argv)
    if rest[:1] == ["sudo"] and "--" in rest:
        rest = rest[rest.index("--") + 1:]
    if rest[:1] == ["env"]:
        rest = rest[1:]
        while rest and (rest[0] == "-i" or "=" in rest[0]):
            rest = rest[1:]
    return " ".join(rest)[:200]


def stream(argv):
    print("$ " + shown(argv), flush=True)
    return subprocess.call(argv)


def restart(entry):
    return stream(as_account([term_llm(), "service", "restart", "web"], entry))


def update(entry, branch=None):
    need_root("silo update")
    if branch is None:
        try:
            manifest = json.loads((PREFIX / "state/install-manifest.json").read_text())
            branch = manifest.get("branch") if isinstance(manifest, dict) else None
        except (OSError, ValueError):
            branch = None
    if not branch or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_./-]*", branch) or ".." in branch:
        raise Stop("pass --branch BRANCH")
    print("branch: " + branch)
    checked_out = run(["git", "-C", str(INSTALLER), "rev-parse", "--abbrev-ref", "HEAD"]).stdout.strip()
    if checked_out != branch:
        raise Stop("the installer checkout is on " + (checked_out or "an unknown branch") + ", not " + branch + ": git -C " + str(INSTALLER) + " switch " + branch)
    steps = [["git", "-C", str(INSTALLER), "pull", "--ff-only"],
             [str(INSTALLER / "script/metal"), "update", "--config", str(METAL_CONFIG), "--branch", branch]]
    for argv in steps:
        if stream(argv):
            raise Stop("stopped: " + " ".join(argv[:4]) + " failed")
    if restart(entry):
        raise Stop("stopped: the restart failed")
    time.sleep(2)
    print()
    return doctor(entry)


def set_conf_values(path, updates):
    """Rewrite KEY=VALUE lines in the installer config, keeping a timestamped backup."""
    if os.path.islink(path):
        raise Stop(str(path) + " must be a regular file, not a symlink")
    lines = path.read_text().splitlines()
    seen = set()
    for index, line in enumerate(lines):
        key = line.partition("=")[0]
        if key in updates and "=" in line and not line.startswith("#"):
            lines[index] = key + "=" + updates[key]
            seen.add(key)
    lines += [key + "=" + value for key, value in updates.items() if key not in seen]
    info = os.lstat(path)
    folder = os.lstat(path.parent)
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        raise Stop(str(path) + " must be a regular file, not a symlink")
    if is_root() and (folder.st_uid != 0 or folder.st_mode & 0o022):
        raise Stop(str(path.parent) + " must be root-owned and not group/world writable")
    import tempfile

    def write_like(data, prefix):
        descriptor, name = tempfile.mkstemp(prefix=prefix, dir=path.parent)
        with os.fdopen(descriptor, "w") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(name, stat.S_IMODE(info.st_mode))
        if is_root():
            os.chown(name, info.st_uid, info.st_gid)
        return name
    backup = path.with_name(path.name + ".bak-" + time.strftime("%Y%m%d%H%M%S"))
    os.replace(write_like(path.read_text(), ".backup-"), backup)
    os.replace(write_like("\n".join(lines) + "\n", ".metal-"), path)
    return backup


def use_github(silo_repo=GITHUB_SILO):
    """Only SILO_REPO (public). CONVERTER_REPO stays: metal plan resolves it without a token,
    and workspaces clone the private converter from GitHub with the token file instead."""
    need_root("silo use-github")
    if not REPO.fullmatch(silo_repo):
        raise Stop("repositories must be credential-free HTTPS URLs")
    conf = read_conf()
    branch = conf.get("SILO_BRANCH", "mvp/metal-installer")
    if run(["git", "ls-remote", "--heads", silo_repo, "refs/heads/" + branch], timeout=60).returncode:
        raise Stop("can't reach " + silo_repo + " branch " + branch + ": nothing changed")
    backup = set_conf_values(METAL_CONFIG, {"SILO_REPO": silo_repo})
    print("config: SILO_REPO now " + silo_repo + " (backup " + str(backup) + ")")
    if (INSTALLER / ".git").exists() and stream(["git", "-C", str(INSTALLER), "remote", "set-url", "origin", silo_repo]):
        raise Stop("couldn't set the installer checkout's origin")
    print("installer checkout now pulls from " + silo_repo + "\nnext: silo update")
    return 0


def shell(entry):
    need_root("silo shell")
    argv = as_account(["bash", "-l"], entry)
    os.chdir(entry.pw_dir)
    os.execvp(argv[0], argv)


def op_session(output):
    """Session variables from `op signin` output (what `eval "$(op signin)"` would export)."""
    return dict(re.findall(r'export (OP_SESSION_[A-Za-z0-9_]+)="([^"]*)"', output))


def prime(entry):
    if os.geteuid() != entry.pw_uid:
        argv = as_account([str(SELF), "prime"], entry)
        os.execvp(argv[0], argv)
    reference, op_account, _ = config_ref(entry)
    if not reference:
        raise Stop("no op-cache reference in ~/.config/term-llm/config.yaml")
    signin = subprocess.run(["op", "signin", *(["--account", op_account] if op_account else [])], stdout=subprocess.PIPE, text=True)
    session = op_session(signin.stdout)
    if signin.returncode or not session:
        raise Stop("1Password sign-in failed (or op returned no session). Manually, as the account: "
                   "eval \"$(op signin --account ACCOUNT)\", then op-cache read REFERENCE > /dev/null")
    primed = subprocess.run(["op-cache", "read", reference, *(["--account", op_account] if op_account else [])],
                            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, env=dict(os.environ, **session))
    if primed.returncode:
        raise Stop("op-cache read failed: " + primed.stderr.strip()[:200])
    print("PRIMED: Frontier's key is cached for " + duration(op_cache_settings(entry)[2]))
    return 0


def claude_login(entry, flags):
    target = Path(entry.pw_dir) / ".local/bin/claude"
    if not target.exists():
        raise Stop("Claude Code isn't installed for " + entry.pw_name + ": silo shell, then curl -fsSL https://claude.ai/install.sh | bash")
    # The web service's PATH starts with <prefix>/bin (the account's); root's PATH doesn't,
    # so root never runs the account's claude by typing `claude`.
    link = PREFIX / "bin/claude"
    if not link.is_symlink() or os.readlink(link) != str(target):
        if subprocess.call(as_account(["ln", "-sfn", str(target), str(link)], entry)):
            raise Stop("couldn't link " + str(link))
        print("linked " + str(link) + " -> " + str(target))
    mode = ["--console"] if "--console" in flags else ["--claudeai", *(["--sso"] if "--sso" in flags else [])]
    argv = as_account([str(target), "auth", "login", *mode], entry)
    status = subprocess.call(argv)
    subprocess.call(as_account([str(target), "auth", "status", "--text"], entry))
    return status


def intake(entry, project):
    if not isinstance(project, str) or not PROJECT.fullmatch(project):
        raise Stop("project names: letters, digits, - and _ (max 63)")
    base = PREFIX / "intake"
    folder = base / project
    # Every level is opened without following symlinks and the next is reached through the
    # parent's descriptor, so swapping any of them for a symlink can't redirect this.
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    created = False
    try:
        prefix_fd = os.open(PREFIX, flags)
    except OSError:
        raise Stop(str(PREFIX) + " is not a plain directory")
    try:
        try:
            os.mkdir("intake", 0o700, dir_fd=prefix_fd)
            if is_root():
                os.chown("intake", entry.pw_uid, entry.pw_gid, dir_fd=prefix_fd, follow_symlinks=False)
        except FileExistsError:
            pass
        try:
            base_fd = os.open("intake", flags, dir_fd=prefix_fd)
        except OSError:
            raise Stop(str(base) + " is not a plain directory")
    finally:
        os.close(prefix_fd)
    try:
        try:
            os.mkdir(project, 0o700, dir_fd=base_fd)
            created = True
        except FileExistsError:
            pass
        try:
            top = os.open(project, flags, dir_fd=base_fd)
        except OSError:
            raise Stop(str(folder) + " is not a plain directory (symlinks are refused)")
    finally:
        os.close(base_fd)
    count = total = 0
    try:
        owner = os.fstat(top).st_uid
        if owner != entry.pw_uid and not (created and owner == 0):
            raise Stop(str(folder) + " has an unexpected owner")
        if is_root():
            os.fchown(top, entry.pw_uid, entry.pw_gid)
        for _path, dirs, files, dirfd in os.fwalk(".", dir_fd=top, follow_symlinks=False):
            regular = set(files)
            for name in dirs + files:
                info = os.stat(name, dir_fd=dirfd, follow_symlinks=False)
                # Files copied in as root become the account's, so the data agent can sort them.
                if is_root() and info.st_uid != entry.pw_uid:
                    os.chown(name, entry.pw_uid, entry.pw_gid, dir_fd=dirfd, follow_symlinks=False)
                if name in regular and stat.S_ISREG(info.st_mode):
                    count += 1
                    total += info.st_size
    finally:
        os.close(top)
    print("drop folder: " + str(folder))
    print("contents: %d file(s), %.1f MB" % (count, total / 1e6))
    if count and is_root():
        print("These files now belong to " + entry.pw_name + ". Next: in the web UI, start a chat with migration-data and ask it to\n"
              "take the export for workspace " + project + ". To add more files later, copy them in and run `silo intake " + project + "` again.")
    elif count:
        print("Run `silo intake " + project + "` as root after copying files in, so they belong to " + entry.pw_name + ".")
    else:
        print("copy files in from your Mac with:\n  scp FILES SERVER:" + str(folder) + "/\nthen run `silo intake " + project + "` again as root to hand them to the service account.")
    return 0


# -- main ------------------------------------------------------------------------------

def main(args):
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    command, rest = args[0], args[1:]
    known = {"doctor", "update", "use-github", "restart", "shell", "prime", "claude-login", "intake"}
    if command not in known:
        raise Stop("unknown command; see silo --help")
    entry = account()
    if command == "doctor" and not rest:
        return doctor(entry)
    if command == "update":
        if rest and (len(rest) != 2 or rest[0] != "--branch"):
            raise Stop("usage: silo update [--branch BRANCH]")
        return update(entry, rest[1] if rest else None)
    if command == "use-github" and not rest:
        return use_github()
    if command == "restart" and not rest:
        return restart(entry)
    if command == "shell" and not rest:
        return shell(entry)
    if command == "prime" and not rest:
        return prime(entry)
    if command == "claude-login" and set(rest) <= {"--sso", "--console"}:
        return claude_login(entry, rest)
    if command == "intake" and len(rest) == 1:
        return intake(entry, rest[0])
    raise Stop("wrong arguments; see silo --help")


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Stop as stop:
        print("silo: " + str(stop), file=sys.stderr)
        sys.exit(2)
    except KeyboardInterrupt:
        sys.exit(130)
