#!/usr/bin/env python3
"""Trusted host control launcher; no shell evaluation and no container Git credentials."""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import stat
import subprocess
import sys

CONTROL_REF = "ruby@sha256:32ca6f94a3ffe387eb1b9d34edc4be8e9308da1c80a3dce8b7b8310d84949240"
# Same qualified control payload as runtime/profiles/discourse-2026.11.0-latest-3158c750.json.
DEFAULT_PROFILE = "discourse-2026.11.0-latest-3158c750"
KEYS = {"SILO_MIGRATE_BASE_PATH", "SILO_CONTROL_GEMS", "SILO_CONTROL_SITE_CACHE",
        "SILO_RUNTIME_PROFILES_DIR", "SILO_CONTROL_IMAGE_REF"}


def refuse(code):
    raise ValueError(code)


def capture(args, extra_env=None):
    # No inherited GIT_* settings (e.g. GIT_CONFIG_PARAMETERS) reach host Git, and
    # every call is bounded: an include pointing at a FIFO must not hang a held lock.
    env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
    env.update(GIT_CONFIG_NOSYSTEM="1", GIT_TERMINAL_PROMPT="0")
    env.update(extra_env or {})
    try:
        result = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env,
                                stdin=subprocess.DEVNULL, timeout=600)
    except subprocess.TimeoutExpired:
        refuse("STANDARD_OPERATION_FAILED")
    if result.returncode:
        refuse("STANDARD_OPERATION_FAILED")
    return result.stdout.strip()


def identity(document):
    config = document["Config"]
    body = {"architecture": document.get("Architecture") or "", "os": document.get("Os") or "",
            "diff_ids": document["RootFS"].get("Layers") or [],
            "config": {key: config.get(key) or ([] if key in ("Cmd", "Entrypoint", "Env") else "")
                       for key in ("Cmd", "Entrypoint", "Env", "User", "WorkingDir")}}
    return "sha256:" + hashlib.sha256(json.dumps(body, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()).hexdigest()


def inspect(ref):
    documents = json.loads(capture(["docker", "image", "inspect", ref]))
    if len(documents) != 1:
        refuse("STANDARD_RUNTIME_MISMATCH")
    return documents[0]


def settings():
    values = dict(os.environ)
    configured = bool(values.get("SILO_CONTROL_CONFIG"))
    if configured:
        seen = set()
        for line in Path(values["SILO_CONTROL_CONFIG"]).read_text().splitlines():
            if not line or line.startswith("#"):
                continue
            key, separator, value = line.partition("=")
            if not separator or key not in KEYS or key in seen or not value or "\x00" in value:
                refuse("STANDARD_CONTROL_CONFIG_INVALID")
            seen.add(key)
            values[key] = value
        if not {"SILO_MIGRATE_BASE_PATH", "SILO_CONTROL_GEMS", "SILO_CONTROL_SITE_CACHE"} <= seen:
            refuse("STANDARD_CONTROL_CONFIG_INVALID")
    return values, configured


# Keys a plain clone or an engineer's commits need. Anything else in the checkout's
# own .git/config (filters, credential helpers, sshCommand, includes, aliases,
# diff/merge drivers...) could run a command as this Docker-group account.
CONVERTER_CONFIG_KEYS = re.compile(r"(?:core\.(?:repositoryformatversion|filemode|bare|logallrefupdates|ignorecase|precomposeunicode|symlinks)"
                                   r"|remote\.origin\.(?:url|fetch)|branch\..+\.(?:remote|merge)|user\.(?:name|email)|pull\.(?:rebase|ff)|fetch\.prune)")
CONVERTER_REMOTE_URL = re.compile(r"(?:https://[^\s@/]+/\S*|ssh://\S+|[A-Za-z0-9._][A-Za-z0-9._-]*@[A-Za-z0-9.][A-Za-z0-9.-]*:[A-Za-z0-9._/~-]+|/[^\s:]*)")


def converter_owned(path, directory):
    try:
        info = os.lstat(path)
    except OSError:
        refuse("STANDARD_CONVERTER_CONFIG")
    kind = stat.S_ISDIR(info.st_mode) if directory else stat.S_ISREG(info.st_mode)
    if not kind or info.st_uid != os.getuid() or info.st_mode & 0o022:
        refuse("STANDARD_CONVERTER_CONFIG")


def converter_config_safe(checkout):
    """Gate run before every other converter Git command; see the Ruby twin."""
    dot_git = checkout / ".git"
    converter_owned(dot_git, True)
    converter_owned(dot_git / "config", False)
    for extra in (dot_git / "commondir", dot_git / "gitdir", dot_git / "config.worktree", checkout / ".gitmodules"):
        if extra.exists() or extra.is_symlink():
            refuse("STANDARD_CONVERTER_CONFIG")
    git = converter_git(checkout)
    own = ("file:.git/config", "file:" + str(dot_git.resolve()) + "/config")
    fields = capture(git + ["config", "--list", "--show-origin", "--show-scope", "--null"]).split("\0")
    if fields and fields[-1] == "":
        fields.pop()
    if len(fields) % 3:
        refuse("STANDARD_CONVERTER_CONFIG")
    for scope, origin, entry in zip(fields[0::3], fields[1::3], fields[2::3]):
        if scope == "command":
            continue
        key, _, value = entry.partition("\n")
        if key == "remote.origin.url":
            safe = bool(CONVERTER_REMOTE_URL.fullmatch(value))
        elif key == "remote.origin.fetch":
            safe = bool(re.fullmatch(r"\+?refs/heads/[^:\s]+:refs/remotes/origin/[^:\s]+", value))
        elif key.endswith(".remote"):
            safe = value in ("origin", ".")
        elif key.endswith(".merge"):
            safe = value.startswith("refs/heads/")
        else:
            safe = "\n" not in value
        if not (scope == "local" and origin in own and CONVERTER_CONFIG_KEYS.fullmatch(key) and safe):
            refuse("STANDARD_CONVERTER_CONFIG: the converter checkout's .git/config has settings that could run commands; inspect it with git config --file converter/.git/config --list, remove them, then retry.")
    dirs = capture(git + ["rev-parse", "--git-dir", "--git-common-dir"]).split("\n")
    if len(dirs) != 2 or any(d not in (".git", str(dot_git.resolve())) for d in dirs):
        refuse("STANDARD_CONVERTER_CONFIG")
    if any(line.startswith("160000 ") for line in capture(git + ["ls-files", "--stage"]).splitlines()):
        refuse("STANDARD_CONVERTER_CONFIG")


def converter_git(checkout, credentials=False, cwd=None):
    # Only clone/fetch may use the account's own Git config and credential helpers.
    return [*([] if credentials else ["env", "GIT_CONFIG_GLOBAL=/dev/null"]),
            "git", "-c", "core.hooksPath=/dev/null", "-c", "core.fsmonitor=false",
            "-c", "core.untrackedCache=false", "-c", "protocol.allow=never", "-c", "protocol.https.allow=always",
            "-c", "protocol.ssh.allow=always", "-c", "protocol.file.allow=always",
            "-c", "submodule.recurse=false", "-c", "fetch.recurseSubmodules=false",
            "-c", "safe.directory=" + str(checkout.resolve()),
            *([] if credentials else ["-c", "credential.helper="]), "-C", str(cwd or checkout)]


def converter_dev():
    # Loaded by path from beside this file, never from sys.path or the working directory.
    import importlib.util
    sys.dont_write_bytecode = True
    spec = importlib.util.spec_from_file_location("converter_dev", Path(__file__).resolve().parent / "converter_dev.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def github_credentials(checkout, url, cwd=None):
    """Git argv using the engineer's GitHub token file for a github.com HTTPS remote, or None.

    Without a token for that owner, clone/fetch fall back to the account's own Git
    configuration as before (public repositories need none)."""
    dev = converter_dev()
    match = dev.GITHUB_REMOTE.fullmatch(url)
    if not match:
        return None
    try:
        token_path, _ = dev.token_for(match[1], os.path.expanduser("~"))
    except dev.Refusal as refusal:
        if str(refusal) == "STANDARD_PUSH_TOKEN_MISSING":
            return None
        raise
    options, env = dev.credential_config(token_path)
    argv = converter_git(checkout, cwd=cwd)
    return argv[:-2] + options + argv[-2:], env


def data_tools():
    import importlib.util
    sys.dont_write_bytecode = True
    spec = importlib.util.spec_from_file_location("data_tools", Path(__file__).resolve().parent / "data_tools.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def host_data(args, values, base, self):
    """`data WS`: the migration-data agent's operations (bin/data_tools.py), JSON on stdin.
    `dbhub WS`: the project's DBHub MCP server over stdio (term-llm starts it; never prints here)."""
    module = data_tools()
    if args[:1] == ["dbhub"]:
        return module.dbhub_main(args, values, base, Path(__file__).resolve().parent.parent, sys.modules[__name__])
    result = module.main(args, values, base, Path(__file__).resolve().parent.parent, sys.modules[__name__], sys.stdin,
                         module.control_runner(self))
    sys.stdout.buffer.write((json.dumps(result, ensure_ascii=False) + "\n").encode("utf-8"))
    return 0


def host_converter(args, values, base, self):
    if len(args) >= 2 and args[1] in ("dev", "push", "push-show"):
        result = converter_dev().main(args, values, base, Path(__file__).resolve().parent.parent, sys.modules[__name__], sys.stdin)
        # UTF-8 bytes, as converter_dev.fit measured them, whatever the locale.
        sys.stdout.buffer.write((json.dumps(result, ensure_ascii=False) + "\n").encode("utf-8"))
        return 0
    if len(args) < 3 or args[1] not in ("clone", "update"):
        refuse("STANDARD_ARGUMENTS_INVALID")
    action, workspace = args[1:3]
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_-]{0,62}", workspace):
        refuse("STANDARD_ARGUMENTS_INVALID")
    root = base / workspace
    if root.is_symlink() or not (root / ".silo-migrate/named/state.json").is_file():
        refuse("STANDARD_NOT_INITIALIZED")
    checkout = root / "converter"
    if action == "clone":
        opts = {}
        tail = args[3:]
        while tail:
            key = tail.pop(0)
            if key not in ("--repo", "--branch") or key in opts or not tail:
                refuse("STANDARD_ARGUMENTS_INVALID")
            opts[key] = tail.pop(0)
            if not opts[key] or opts[key].startswith("-"):
                refuse("STANDARD_ARGUMENTS_INVALID")
        if checkout.exists() or checkout.is_symlink():
            refuse("STANDARD_CONVERTER_EXISTS")
        repo = opts.get("--repo", "https://github.com/discourse-org/discourse-converters.git")
        branch = opts.get("--branch", "main")
        if not CONVERTER_REMOTE_URL.fullmatch(repo):
            refuse("STANDARD_ARGUMENTS_INVALID")
        # A github.com remote uses the engineer's token file when there is one; otherwise the
        # account's Git config, SSH agent and credential helpers, host-side as before.
        token = github_credentials(checkout, repo, cwd=root)
        if token:
            capture(token[0] + ["clone", "--branch", branch, "--", repo, str(checkout)], token[1])
        else:
            capture(converter_git(checkout, credentials=True, cwd=root) + ["clone", "--branch", branch, "--", repo, str(checkout)])
        print(json.dumps({"version": 1, "status": "cloned"}))
        return 0
    if len(args) != 3 or checkout.is_symlink() or not checkout.is_dir():
        refuse("STANDARD_ARGUMENTS_INVALID")
    standard = root / ".silo-migrate/named/standard"
    # Match StandardStore's op.lock. Never create/truncate it or follow a link.
    fd = os.open(standard / "op.lock", os.O_RDONLY | os.O_NOFOLLOW)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            refuse("STANDARD_BUSY")
        state = json.loads((standard / "state.json").read_text())
        if any(run.get("status") in ("claimed", "running") for run in state.get("runs", {}).values()):
            refuse("STANDARD_BUSY")
        config = state["config"]
        if Path(config["converter_worktree"]).resolve() != checkout.resolve():
            refuse("STANDARD_RUNTIME_MISMATCH")
        branch = config["converter"]["branch"]
        converter_config_safe(checkout)
        git = converter_git(checkout)
        if capture(git + ["--no-optional-locks", "status", "--porcelain", "--untracked-files=all", "--ignore-submodules=all"]):
            refuse("STANDARD_CONVERTER_DIRTY: Commit changes (optionally on a development branch) or stash, then run standard converter refresh.")
        if branch == "detached" or capture(git + ["rev-parse", "--abbrev-ref", "HEAD"]) != branch:
            refuse("STANDARD_RUNTIME_MISMATCH")
        # Only fetch may use credentials: the token file for github.com, else the account's helper.
        token = github_credentials(checkout, capture(git + ["remote", "get-url", "origin"]))
        if token:
            capture(token[0] + ["fetch", "origin"], token[1])
        else:
            capture(converter_git(checkout, credentials=True) + ["fetch", "origin"])
        capture(git + ["merge", "--ff-only", "--", "refs/remotes/origin/" + branch])
    finally:
        os.close(fd)
    # Refresh takes the same lock itself; it rechecks identity and cleanliness.
    return subprocess.call([str(self), "standard", "converter", "refresh", workspace], env=values)


def control_image(repo, values, base, args):
    profile_name = DEFAULT_PROFILE
    config = None
    # Find only syntactically valid, initialized workspace arguments. Grouped
    # commands (plan/run/dataset/etc.) put WS after the subcommand.
    candidates = args[1:] if args[:1] == ["start-run"] else args[2:] if args[:1] == ["standard"] else []
    for workspace in candidates:
        if re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_-]{0,62}", workspace):
            binding = base / workspace / ".silo-migrate/named/standard/state.json"
            if binding.is_file():
                config = json.loads(binding.read_text())["config"]
                profile_name = config["discourse_profile"]
                break
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}", profile_name):
        refuse("STANDARD_RUNTIME_MISMATCH")
    directories = {repo / "runtime/profiles", Path(values.get("SILO_RUNTIME_PROFILES_DIR", str(repo / "runtime/profiles")))}
    paths = list({p.resolve() for d in directories if (p := d / (profile_name + ".json")).is_file()})
    if len(paths) != 1:
        refuse("STANDARD_RUNTIME_MISMATCH")
    raw = paths[0].read_bytes()
    if config and hashlib.sha256(raw).hexdigest() != config["discourse_profile_sha256"]:
        refuse("STANDARD_RUNTIME_MISMATCH")
    return json.loads(raw)["images"]["control"]


def main(args):
    self = Path(__file__).resolve()
    repo = self.parent.parent
    values, configured = settings()
    # Identity inspection is host-only, including on machines without Ruby.
    if args[:1] == ["image-identity"]:
        if len(args) != 2:
            refuse("STANDARD_ARGUMENTS_INVALID")
        print(identity(inspect(args[1])))
        return 0
    project = Path(values.get("SILO_CONTROL_PROJECT", str(repo.parent.parent)))
    base = Path(values.get("SILO_MIGRATE_BASE_PATH", str(project / ".runtime-cache/mvp-workspaces")))
    gems = Path(values.get("SILO_CONTROL_GEMS", str(project / ".runtime-cache/gems")))
    if args[:1] == ["converter"]:
        return host_converter(args, values, base, self)
    if args[:1] in (["data"], ["dbhub"]):
        return host_data(args, values, base, self)
    image = values.get("SILO_CONTROL_IMAGE_REF", CONTROL_REF) if configured else CONTROL_REF.split("@", 1)[1]
    if configured:
        control = control_image(repo, values, base, args)
        image = values.get("SILO_CONTROL_IMAGE_REF", control["ref"])
        try:
            document = inspect(image)
        except ValueError:
            if "@sha256:" not in image:
                raise
            document = inspect("silo-migrate/loaded:" + control["content_id"][7:])
        if identity(document) != control["content_id"] or not re.fullmatch(r"sha256:[0-9a-f]{64}", document.get("Id", "")):
            refuse("STANDARD_RUNTIME_MISMATCH")
        image = document["Id"]
    base.mkdir(mode=0o700, parents=True, exist_ok=True)
    mode = ["--rm", "-i"]
    if args[:1] == ["--detach"]:
        args = args[1:]
        mode = ["--rm", "-d", "--name", "silo-control-" + secrets.token_hex(4)]
    if args[:1] == ["start-run"]:
        if len(args) != 3:
            refuse("STANDARD_ARGUMENTS_INVALID")
        claimed = json.loads(capture([str(self), "standard", "run", "claim", *args[1:]]))
        run_id = claimed["run_id"]
        print(json.dumps(claimed), flush=True)
        result = subprocess.run([str(self), "--detach", "standard", "run", "execute", args[1], run_id], stdout=subprocess.DEVNULL)
        if result.returncode:
            print("Error: STANDARD_RUN_NOT_STARTED. Recover with: standard run recover " + args[1] + " " + run_id, file=sys.stderr)
        return result.returncode
    command = ["docker", "run", *mode, "--pull=never", "--restart", "no", "--network", "host", "--read-only",
               "--user", f"{os.getuid()}:{os.getgid()}", "--group-add", str(Path("/var/run/docker.sock").stat().st_gid),
               "--cap-drop", "ALL", "--security-opt", "no-new-privileges", "--cpus", "0.25", "--memory", "512m",
               "--memory-swap", "512m", "--pids-limit", "256", "--log-opt", "max-size=1m", "--tmpfs", "/tmp:rw,exec,size=256m,mode=1777"]

    def mount(source, destination, readonly=True):
        if not Path(source).is_absolute() or "," in str(source):
            refuse("STANDARD_CONTROL_CONFIG_INVALID")
        command.extend(["--mount", f"type=bind,src={source},dst={destination}" + (",readonly" if readonly else "")])

    mount(repo if configured else project, repo if configured else project)
    mount(base, base, False)
    mount(gems, "/gems")
    mount("/var/run/docker.sock", "/var/run/docker.sock", False)
    mount("/usr/bin/docker", "/usr/local/bin/docker")
    for key in ("SILO_CONTROL_SITE_CACHE", "SILO_RUNTIME_PROFILES_DIR"):
        if values.get(key):
            mount(values[key], values[key])
            command.extend(["-e", key + "=" + values[key]])
    environment = {"HOME": "/tmp", "USER": "silo", "TMPDIR": "/tmp", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8",
                   "GEM_HOME": "/gems", "GEM_PATH": "/gems:/gems/ruby/3.3.0", "BUNDLE_PATH": "/gems",
                   "BUNDLE_FROZEN": "true", "BUNDLE_APP_CONFIG": "/tmp/bundle-config", "BUNDLE_AUTO_INSTALL": "false",
                   "BUNDLE_DISABLE_VERSION_CHECK": "true", "RUBYOPT": "-W0", "SILO_MIGRATE_BASE_PATH": str(base),
                   "SILO_MIGRATE_USER_CONFIG": "/tmp/user-config.env", "GIT_CONFIG_NOSYSTEM": "1"}
    for key, value in environment.items():
        command.extend(["-e", key + "=" + value])
    command.extend(["-w", str(repo), image, "bundle", "_2.6.9_", "exec", "ruby", "bin/silo-migrate", *args])
    os.execvp(command[0], command)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (ValueError, OSError, KeyError, TypeError):
        # Do not disclose raw Git/config/inspect data (may contain credentials).
        error = sys.exc_info()[1]
        code = str(error) if isinstance(error, ValueError) and re.match(r"(STANDARD|NAMED)_", str(error)) else "STANDARD_OPERATION_FAILED"
        print("Error: " + code, file=sys.stderr)
        sys.exit(1)
