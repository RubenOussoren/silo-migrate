#!/usr/bin/env -S python3 -I
"""Replace the bundled Varnish theme with one chosen upstream commit.

  script/update-varnish COMMIT          (the full 40-character commit)

The folder integrations/term-llm/extensions/varnish is a copy of upstream, unmodified except for the
checked compatibility patches this script applies (PATCHES below; the same ones the Development node's
update helper uses). Nobody edits the folder by hand: our changes live in the silo-theme extension. Each
patch recognises the exact upstream code or its already-fixed form and refuses anything else, so an
upstream change gets a person's review. This fetches the commit, replaces the folder as a whole (keeping
local.json), records what was installed (with each patch and the upstream hashes of the files it
changed) in silo-theme/varnish-upstream.json and shows what changed. Nothing from upstream is run.

Updates are deliberate. This code runs on pages showing customer data, so the known forms of outside
address stop the update, and the network calls are listed for a person to read. A search can't catch
everything: read the changes and run the live browser tests before shipping the result.
"""
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

REPOSITORY = "https://github.com/keegangeorge/term-llm-varnish.git"
# A clone to fetch from instead (tests; a local checkout of the same repository). The record always names
# REPOSITORY, never a local path.
UPSTREAM = os.environ.get("VARNISH_UPSTREAM", REPOSITORY)
ROOT = Path(os.environ.get("VARNISH_REPO_ROOT", Path(__file__).resolve().parents[1]))
EXTENSIONS = ROOT / "integrations/term-llm/extensions"
TARGET = EXTENSIONS / "varnish"
RECORD = EXTENSIONS / "silo-theme/varnish-upstream.json"
# Full commits only: a short hash can resolve to a tag of the same name.
COMMIT = re.compile(r"[0-9a-f]{40}\Z")
# Development material the running extension doesn't use.
LEFT_OUT = re.compile(r"(?:\.github/|docs/|tools/|install\.sh\Z|CONTRIBUTING\.md\Z|\.gitignore\Z)")
KEPT = "local.json"
# Every file is one of these kinds; anything else stops an update. Only code is searched: the rest
# isn't loaded as code by the browser.
CODE = (".js", ".mjs", ".css")
INERT = (".woff2", ".woff", ".md", ".txt", ".json", ".yaml")
INERT_NAMES = ("LICENSE",)
# Comments are searched too: a line that starts like a comment can still hold code.
ADDRESS = re.compile(r"""(?:https?|wss?|ftp):(?:\\?/){2}[^\s"'`)]*|["'`]//[^\s"'`/]|url\(\s*["']?//|@import\s+["']?//""", re.I)
HARMLESS = re.compile(r"https?://www\.w3\.org/|https://simpleicons\.org/?\Z", re.I)
# term-llm 0.9.99 wraps each Runtime popover <select> in <span class="control-select">. Upstream puts
# its provider mark before the select, so inside that wrapper: its direct-child CSS stopped sizing the
# SVG (a ~320px logo filled the popover) and its direct-child lookup added another mark every frame.
# Find the mark anywhere in the field; size the SVG at any depth; overlay it inside .control-select.
# The old direct-child rules for older hosts stay. Submitted upstream as keegangeorge/term-llm-varnish#20
# (2026-11-10): once upstream has a fix, this refuses the changed code; review it, and drop this patch
# if upstream's fix passes the Runtime popover browser check.
OLD_MARK_LOOKUP = '      let mark = field.querySelector(":scope > .vn-field-mark");\n'
FIXED_MARK_LOOKUP = (
    '      // Newer hosts wrap the native select in .control-select (with its own\n'
    '      // chevron); find the mark wherever it was placed so it is created once.\n'
    '      let mark = field.querySelector(".vn-field-mark");\n')
OLD_MARK_CSS = '.runtime-popover-field > .vn-field-mark svg { width: 14px; height: 14px; }\n'
FIXED_MARK_CSS = '''.runtime-popover-field .vn-field-mark svg { width: 14px; height: 14px; }

/* Hosts that wrap the select in .control-select: overlay inside the wrapper. */
.runtime-popover-field .control-select > .vn-field-mark {
  grid-row: 1;
  grid-column: 1;
  z-index: 1;
  display: inline-flex;
  align-self: center;
  justify-self: start;
  margin-left: 11px;
  color: var(--vn-accent);
  pointer-events: none;
}

.runtime-popover-field .control-select > .vn-field-mark + .runtime-popover-select {
  grid-row: 1;
  grid-column: 1;
  padding-left: 33px;
}
'''
# Through the Hub, a node's web UI is at /hub/node/<id>/, but upstream finds the node only at
# /node/<id>/ (start of the path), so the node's own accent, favicon and per-node settings don't
# apply there. The same one-expression change as the Development node's (infrastructure
# scripts/update_varnish.py, "hub_compatibility"); drop it once upstream supports prefixed paths.
OLD_NODE_ID = r'location.pathname.match(/^\/node\/([^/]+)\//)'
FIXED_NODE_ID = r'location.pathname.match(/\/node\/([^/]+)\//)'
PATCHES = {"runtime_marks": (("main.js", OLD_MARK_LOOKUP, FIXED_MARK_LOOKUP), ("style.css", OLD_MARK_CSS, FIXED_MARK_CSS)),
           "hub_node_id": (("util.js", OLD_NODE_ID, FIXED_NODE_ID),)}
NETWORK = re.compile(r"\bfetch\(|\bWebSocket\(|\bEventSource\(|\bXMLHttpRequest\b|\bsendBeacon\(|\bimport\(")


def git(args, cwd=None):
    return subprocess.run(["git", "-c", "core.hooksPath=/dev/null", *args], cwd=cwd, check=True, capture_output=True, text=True).stdout


def sha256(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def scan(folder):
    """Outside addresses, which stop an update, and the network calls, for a person to read."""
    outside, network = [], []
    for path in sorted(folder.rglob("*")):
        if path.is_file() and path.suffix in CODE:
            for number, line in enumerate(path.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
                where = "%s:%d" % (path.relative_to(folder), number)
                if any(not HARMLESS.match(found.group()) for found in ADDRESS.finditer(line)):
                    outside.append(where)
                if NETWORK.search(line):
                    network.append(where)
    return outside, network


def refuse_unknown_files(folder):
    """Stop on any file type we don't know how to judge, and on an entry that isn't code."""
    for path in sorted(folder.rglob("*")):
        if path.is_file() and path.suffix not in CODE + INERT and path.name not in INERT_NAMES:
            raise SystemExit("update-varnish: %s is a file type this doesn't check; refusing" % path.relative_to(folder))
    for line in (folder / "extension.yaml").read_text(encoding="utf-8").splitlines():
        if re.match(r"""\s*["']?(?:js|css)["']?\s*:""", line):
            entry = re.fullmatch(r"(?:js|css):\s*(\S+)\s*", line)
            if not entry or not entry[1].endswith(CODE):
                raise SystemExit("update-varnish: extension.yaml has an entry this can't check: %s" % line.strip())


def apply_patch(folder, name, edits):
    """All of a patch's replacements, or none: (status, {file: upstream sha256} of the files it changed)."""
    planned = []
    for filename, old, fixed in edits:
        text = (folder / filename).read_text() if (folder / filename).is_file() else ""
        if text.count(old) == 1 and fixed not in text:
            planned.append((filename, text, text.replace(old, fixed)))
        elif text.count(fixed) == 1 and old not in text:
            planned.append(None)
        else:
            raise SystemExit("update-varnish: upstream changed the code the %s patch fixes (%s); review it before updating" % (name, filename))
    if all(item is None for item in planned):
        return "already-supported", {}
    if any(item is None for item in planned):
        raise SystemExit("update-varnish: upstream fixed only part of what the %s patch fixes; review it before updating" % name)
    upstream = {}
    for filename, text, patched in planned:
        upstream[filename] = sha256(folder / filename)
        (folder / filename).write_text(patched)
    return "patched", upstream


def install(source, commit):
    listed = git(["ls-tree", "-r", "--full-tree", "HEAD"], cwd=source).splitlines()
    names = []
    for entry in listed:
        info, name = entry.split("\t", 1)
        if not LEFT_OUT.match(name):
            if info.split()[0] not in ("100644", "100755"):
                raise SystemExit("update-varnish: %s isn't a regular file; refusing" % name)
            names.append(name)
    fresh, old = TARGET.with_name(".varnish.new"), TARGET.with_name(".varnish.old")
    shutil.rmtree(fresh, ignore_errors=True)
    shutil.rmtree(old, ignore_errors=True)
    try:
        for name in names:
            (fresh / name).parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(source / name, fresh / name)
        for required in ("LICENSE", "fonts/OFL.txt", "extension.yaml"):
            if not (fresh / required).is_file():
                raise SystemExit("update-varnish: upstream has no %s; refusing" % required)
        refuse_unknown_files(fresh)
        patches = {}
        for name, edits in PATCHES.items():
            status, upstream = apply_patch(fresh, name, edits)
            patches[name] = {"status": status, "upstream_files": upstream}
        outside, network = scan(fresh)
        if outside:
            raise SystemExit("update-varnish: outside addresses, not installed:\n  " + "\n  ".join(outside))
        before = json.loads(RECORD.read_text())["files"] if RECORD.is_file() else {}
        after = {name: sha256(fresh / name) for name in sorted(names)}
        if (TARGET / KEPT).is_file():
            shutil.copyfile(TARGET / KEPT, fresh / KEPT)
        if TARGET.exists():
            TARGET.rename(old)
        fresh.rename(TARGET)
        written = RECORD.with_name(RECORD.name + ".new")
        record = {"repository": REPOSITORY, "commit": commit, "files": after, "patches": patches}
        if UPSTREAM != REPOSITORY:
            record["fetched_from_a_clone"] = True
        written.write_text(json.dumps(record, indent=2) + "\n")
        written.replace(RECORD)
        shutil.rmtree(old, ignore_errors=True)
    finally:
        shutil.rmtree(fresh, ignore_errors=True)
    print("varnish is now " + commit + "".join("; %s: %s" % (name, patch["status"]) for name, patch in patches.items()))
    for label, changed in (("added", sorted(set(after) - set(before))), ("removed", sorted(set(before) - set(after))),
                           ("changed", sorted(name for name in set(after) & set(before) if after[name] != before[name]))):
        if changed:
            print(label + ": " + ", ".join(changed))
    print("network calls, read these:\n  " + "\n  ".join(network))
    print("Next: run the browser tests, then check silo-theme still fits.")


def main(args):
    if len(args) != 1 or not COMMIT.fullmatch(args[0]):
        raise SystemExit(__doc__.strip())
    with tempfile.TemporaryDirectory() as temporary:
        source = Path(temporary) / "varnish"
        git(["clone", "--quiet", "--no-tags", UPSTREAM, str(source)])
        git(["checkout", "--quiet", "--detach", args[0]], cwd=source)
        head = git(["rev-parse", "HEAD"], cwd=source).strip()
        if head != args[0]:
            raise SystemExit("update-varnish: got %s instead of the requested commit; refusing" % head)
        install(source, head)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
