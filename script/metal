import stat
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request

SELF = Path(sys.argv.pop(1)).resolve()
ROOT = SELF.parent.parent
PIN = "2d264d175d7f8a7108a3d3530338efa2b81dadcaf5ce02c3d0f701fa88ad3d4e"
PACKAGES = ("git", "curl", "ca-certificates", "python3", "util-linux", "gzip", "tar", "gnupg")
DEFAULTS = dict(SILO_ACCOUNT="silomig", SILO_PREFIX="/srv/silo-migrate", SILO_WORKSPACES="",
    SILO_REPO="https://github.com/RubenOussoren/silo-migrate.git", SILO_BRANCH="mvp/metal-installer",
    CONVERTER_REPO="https://github.com/discourse-org/discourse-converters.git", CONVERTER_BRANCH="main",
    VERIFY_CONVERTER_BRANCH="mvp/metal-installer", ARTIFACT_PACKAGE="", TERM_LLM_VERSION="0.9.93",
    TERM_LLM_PORT="18800", TERM_LLM_SERVICE="install", DOCKER_INSTALL="if-missing", PORT_RANGE="18080-18089", KEEP_RELEASES="3",
    VERIFY_MIN_AVAILABLE_MIB="8192", HUB_URL="", HUB_NODE_ID="", HUB_NODE_NAME="", HUB_SECRETS_FILE="")
FRESH_CONFIG = """# Work-only; no imported providers, sessions, memory or jobs.
provider_discovery: config
providers: {}
approval:
  default_mode: prompt
serve:
  approval_mode: prompt
  extensions: []
  auto_title: false
  projects:
    enabled: false
# The web UI's agent picker then offers only the installed migration agents; built-in
# shell-capable agents would otherwise run with this account's Docker authority.
agents:
  use_builtin: false
  search_paths:
    - {agents_path}
