def agents_path():
    # term-llm lists agents from search paths; symlinked agent folders are skipped.
    return str(P/"current/integrations/term-llm")

def fresh_config():
    return FRESH_CONFIG.replace("{agents_path}", agents_path())

class Refusal(Exception):
    pass

def refuse(code, recovery):
    raise Refusal(code + ": " + recovery)

def canonical(obj):
    return json.dumps(obj, sort_keys=True, separators=(",", ":"))

def digest_bytes(data):
    return hashlib.sha256(data).hexdigest()

def sha(path):
    h = hashlib.sha256()
    with open(path, "rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            h.update(block)
    return h.hexdigest()

def load(path):
    return json.loads(Path(path).read_text())

def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()

STAGE = "COMMAND"

def run(argv, *, check=True, account=False, root=False, input=None, timeout=120, relay=False):
    # Never echo argv or child output: tools may print credentials even on failure.
    cmd = list(map(str, argv))
    if root and os.geteuid() != 0:
        cmd = ["sudo", "--"] + cmd
    if account:
        entry = pwd.getpwnam(C["SILO_ACCOUNT"])
        uid = entry.pw_uid
        envargs = ["env", "-i", "HOME=" + entry.pw_dir, "USER=" + entry.pw_name,
                   "LOGNAME=" + entry.pw_name, "PATH=" + str(P / "bin") + ":/usr/local/bin:/usr/bin:/bin",
                   "LANG=C.UTF-8", "TMPDIR=" + str(P/"state/tmp"), "XDG_RUNTIME_DIR=/run/user/" + str(uid),
                   "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/" + str(uid) + "/bus",
                   "GIT_TERMINAL_PROMPT=0", "GIT_CONFIG_NOSYSTEM=1"]
        cmd = (["sudo", "-u", C["SILO_ACCOUNT"], "-H", "--"] if os.geteuid() != uid else []) + envargs + cmd
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_CONFIG_NOSYSTEM="1")
    try:
        if (P/"state/tmp").is_dir():
            env["TMPDIR"] = str(P/"state/tmp")
    except PermissionError:
        pass  # Parent administrator may not traverse the service-owned prefix.
    if C.get("SILO_REPO", "").startswith("/"):
        # Explicitly approved local input only; propagate through upload-pack,
        # which does not inherit `git -c safe.directory=...` from clone.
        env.update(GIT_CONFIG_COUNT="1", GIT_CONFIG_KEY_0="safe.directory", GIT_CONFIG_VALUE_0=C["SILO_REPO"])
    try:
        result = subprocess.run(cmd, input=input, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env, timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired):
        if not check:
            return None
        refuse("METAL_" + STAGE + "_FAILED", "required command unavailable or timed out; inspect prerequisites locally")
    if relay:
        # Only this script's own fixed-format lines are relayed from a child copy of itself.
        for line in result.stderr.splitlines():
            if re.fullmatch(r"METAL_VERIFY_STEP [A-Za-z0-9 _.-]+|METAL_[A-Z_]+: [A-Za-z0-9 ,;=()./_<>-]+", line):
                print(line, file=sys.stderr)
    if check and result.returncode:
        fixed = re.search(r"(?m)^(METAL_[A-Z_]+):", result.stderr)
        if fixed:
            refuse(fixed[1], "account step refused; inspect status locally, fix prerequisite and re-plan (raw output suppressed)")
        # silo-migrate's own refusals are fixed codes and safe to show.
        coded = re.search(r"(?m)^Error: ((?:STANDARD|NAMED|CONTROL)_[A-Z_]+)\b", result.stderr)
        if coded:
            refuse("METAL_" + STAGE + "_FAILED", "silo-migrate refused with " + coded[1] + " (other output suppressed)")
        refuse("METAL_" + STAGE + "_FAILED", "command failed (output suppressed); inspect prerequisites locally, then re-plan")
    return result

def output(argv, **kwargs):
    result = run(argv, check=False, **kwargs)
    return result.stdout.strip() if result and result.returncode == 0 else None

def git(args, **kwargs):
    return output(["git", "-c", "credential.helper=", "-c", "core.hooksPath=/dev/null", "-c", "core.fsmonitor=false", "-c", "core.untrackedCache=false"] + args, **kwargs)

def read_config(path):
    result = dict(DEFAULTS)
    seen = set()
    if path:
        for line in Path(path).read_text().splitlines():
            if not line or line.startswith("#"):
                continue
            match = re.fullmatch(r"([A-Z_]+)=([^\s\x00-\x1f]*)", line)
            if not match or match[1] not in result or match[1] in seen:
                refuse("METAL_CONFIG_INVALID", "use unique documented literal KEY=VALUE lines; unknown keys refused")
            seen.add(match[1])
            result[match[1]] = match[2]
    prefix = result["SILO_PREFIX"]
    if result["SILO_WORKSPACES"] == "$SILO_PREFIX/workspaces" or not result["SILO_WORKSPACES"]:
        result["SILO_WORKSPACES"] = prefix + "/workspaces"
    for key in ("SILO_PREFIX", "SILO_WORKSPACES", "ARTIFACT_PACKAGE"):
        value = result[key]
        if value and (not re.fullmatch(r"/[A-Za-z0-9_./-]+", value) or ".." in Path(value).parts or value == "/"):
            refuse("METAL_CONFIG_INVALID", "paths must be absolute simple paths without traversal")
    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,30}", result["SILO_ACCOUNT"]) or result["SILO_ACCOUNT"] == "root":
        refuse("METAL_CONFIG_INVALID", "select a non-root service account")
    for key in ("SILO_REPO", "CONVERTER_REPO"):
        value = result[key]
        if not (re.fullmatch(r"https://[A-Za-z0-9.-]+/[A-Za-z0-9_./-]+", value) or re.fullmatch(r"/[A-Za-z0-9_./-]+", value)):
            refuse("METAL_CONFIG_INVALID", "repositories must be credential-free HTTPS URLs or absolute local paths")
    for key in ("SILO_BRANCH", "CONVERTER_BRANCH", "VERIFY_CONVERTER_BRANCH"):
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_./-]*", result[key]) or ".." in result[key]:
            refuse("METAL_CONFIG_INVALID", "invalid branch name")
    if not re.fullmatch(r"[0-9]{4,7}", result["VERIFY_MIN_AVAILABLE_MIB"]) or not 2048 <= int(result["VERIFY_MIN_AVAILABLE_MIB"]) <= 1048576:
        refuse("METAL_CONFIG_INVALID", "VERIFY_MIN_AVAILABLE_MIB must be 2048..1048576")
    if result["TERM_LLM_VERSION"] != "0.9.93":
        refuse("METAL_VERSION_UNPINNED", "add a reviewed pinned release SHA before selecting another version")
    if result["TERM_LLM_SERVICE"] not in ("install", "install-and-start", "skip") or result["DOCKER_INSTALL"] not in ("if-missing", "never"):
        refuse("METAL_CONFIG_INVALID", "invalid service/Docker policy")
    hub = [result[k] for k in ("HUB_URL", "HUB_NODE_ID", "HUB_SECRETS_FILE")]
    if any(hub) or result["HUB_NODE_NAME"]:
        # Opt-in reverse node: the server dials out; no inbound port or firewall change.
        if not all(hub) or result["TERM_LLM_SERVICE"] == "skip":
            refuse("METAL_CONFIG_INVALID", "Hub needs HUB_URL, HUB_NODE_ID and HUB_SECRETS_FILE, and a term-llm service")
        if not re.fullmatch(r"https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9_./-]*)?", result["HUB_URL"]):
            refuse("METAL_CONFIG_INVALID", "HUB_URL must be a credential-free HTTPS URL")
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,62}", result["HUB_NODE_ID"]) or (result["HUB_NODE_NAME"] and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,62}", result["HUB_NODE_NAME"])):
            refuse("METAL_CONFIG_INVALID", "invalid Hub node id/name")
        if not re.fullmatch(r"/[A-Za-z0-9_./-]+", result["HUB_SECRETS_FILE"]) or ".." in Path(result["HUB_SECRETS_FILE"]).parts:
            refuse("METAL_CONFIG_INVALID", "HUB_SECRETS_FILE must be an absolute simple path")
    if not result["TERM_LLM_PORT"].isdigit() or not 1 <= int(result["TERM_LLM_PORT"]) <= 65535:
        refuse("METAL_CONFIG_INVALID", "invalid term-llm port")
    ports = re.fullmatch(r"([0-9]+)-([0-9]+)", result["PORT_RANGE"])
    if not ports or not 1 <= int(ports[1]) <= int(ports[2]) <= 65535 or int(ports[2]) - int(ports[1]) > 100:
        refuse("METAL_CONFIG_INVALID", "invalid port range (maximum 101 ports)")
    if not result["KEEP_RELEASES"].isdigit() or int(result["KEEP_RELEASES"]) < 2:
        refuse("METAL_CONFIG_INVALID", "KEEP_RELEASES must be at least two")
    result["SILO_PREFIX"] = str(Path(prefix).resolve())
    workspace = Path(result["SILO_WORKSPACES"]).resolve()
    managed = Path(result["SILO_PREFIX"])
    if workspace == managed or workspace in managed.parents or (managed in workspace.parents and workspace != managed / "workspaces"):
        refuse("METAL_CONFIG_INVALID", "workspace must be separate from prefix or its dedicated workspaces directory")
    result["SILO_WORKSPACES"] = str(workspace)
    return result

def test_override(name, default):
    return os.environ.get("SILO_METAL_TEST_" + name, default) if os.environ.get("SILO_METAL_TESTING") == "1" else default

def os_check(allow=False):
    fields = {}
    for line in Path(test_override("OS_RELEASE", "/etc/os-release")).read_text().splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            fields[key] = value.strip('"')
    ident, version = fields.get("ID"), fields.get("VERSION_ID")
    tested = ident == "debian" and version == "12"
    warning = allow and ((ident == "debian" and version == "13") or ident == "ubuntu")
    arch = test_override("ARCH", output(["dpkg", "--print-architecture"]) or "unknown")
    errors = []
    if not tested and not warning:
        errors.append("METAL_OS_UNSUPPORTED: Debian 12 required; --allow-untested-os permits Debian 13/Ubuntu warnings only")
    if arch != "amd64":
        errors.append("METAL_ARCH_UNSUPPORTED: amd64 required")
    return dict(id=ident, version=version, arch=arch, untested=not tested, errors=errors)

def ancestor(path):
    path = Path(path)
    while True:
        try:
            if path.exists():
                break
        except PermissionError:
            pass
        path = path.parent
    return path

def account_entry():
    try:
        return pwd.getpwnam(C["SILO_ACCOUNT"])
    except KeyError:
        return None

def home():
    entry = account_entry()
    return Path(entry.pw_dir if entry else "/home/" + C["SILO_ACCOUNT"])

def installed(package):
    return output(["dpkg-query", "-W", "-f=${Status}", package]) == "install ok installed"

def missing_packages():
    return [p for p in PACKAGES if not installed(p)]

def occupied(port):
    for family, address in ((socket.AF_INET, "0.0.0.0"), (socket.AF_INET6, "::")):
        try:
            with socket.socket(family) as sock:
                sock.bind((address, port))
        except OSError:
            return True
    return False

def path_state(path):
    path = Path(path)
    try:
        stat = path.lstat()
        state = dict(exists=True, uid=stat.st_uid, gid=stat.st_gid, mode=oct(stat.st_mode & 0o7777), symlink=path.is_symlink())
        if path.is_symlink():
            state["target"] = os.readlink(path)
        elif path.is_file():
            state["sha256"] = sha(path)
        return state
    except FileNotFoundError:
        return {"exists": False}
    except PermissionError:
        return {"exists": None, "accessible": False}

def directory_chain(path):
    path = Path(path)
    return list(reversed(path.parents)) + [path]

def directory_authority(paths):
    entry = account_entry()
    allowed = {0} | ({entry.pw_uid} if entry else set())
    states = {}
    for path in sorted({p for target in paths for p in directory_chain(target)}, key=str):
        state = path_state(path)
        states[str(path)] = state
        if state.get("exists"):
            info = path.lstat()
            if not stat.S_ISDIR(info.st_mode) or info.st_uid not in allowed or info.st_mode & 0o022:
                # Configured paths are not secrets; naming the component makes the fix obvious.
                refuse("METAL_PATH_AUTHORITY", str(path) + " must be a root/account-owned directory, not group/world writable; symlinks refused (chown/chmod it, then re-plan)")
        elif state.get("exists") is None:
            refuse("METAL_PATH_AUTHORITY", str(path) + " unavailable; inspect as service account")
    return states

def secure_directory(path, uid, gid):
    # Walk via pinned directory descriptors: no symlink following or owner repair.
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    try:
        parts = Path(path).parts[1:]
        for index, part in enumerate(parts):
            created = False
            try:
                child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            except FileNotFoundError:
                os.mkdir(part, 0o750, dir_fd=fd)
                child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
                created = True
            info = os.fstat(child)
            if created:
                os.fchown(child, uid, gid)
            elif info.st_uid not in ({uid} if index == len(parts)-1 else {0, uid}) or info.st_mode & 0o022:
                os.close(child)
                refuse("METAL_PATH_AUTHORITY", "unexpected directory owner or writable ancestor; no ownership repair performed")
            if index == len(parts)-1:
                os.fchmod(child, 0o750)
            os.close(fd)
            fd = child
    except OSError:
        refuse("METAL_PATH_AUTHORITY", "unsafe/unavailable directory component; symlinks refused")
    finally:
        os.close(fd)

def resolve(repo, branch):
    local = ["--upload-pack=git -c " + shlex.quote("safe.directory=" + repo) + " upload-pack"] if repo.startswith("/") else []
    result = git(["ls-remote"] + local + ["--heads", repo, "refs/heads/" + branch])
    if result and re.fullmatch(r"[0-9a-f]{40}\s+refs/heads/" + re.escape(branch), result):
        return result.split()[0]
    # A minimal Debian cloud image may lack git. Resolve read-only before planning
    # its apt installation: bare refs locally, smart-HTTP advertisements remotely.
    if not shutil.which("git"):
        ref = "refs/heads/" + branch
        if repo.startswith("/"):
            bare = Path(repo)
            loose = bare/ref
            if loose.is_file() and re.fullmatch(r"[0-9a-f]{40}\n?", loose.read_text()):
                return loose.read_text().strip()
            if (bare/"packed-refs").is_file():
                for line in (bare/"packed-refs").read_text().splitlines():
                    if re.fullmatch(r"[0-9a-f]{40} " + re.escape(ref), line):
                        return line.split()[0]
        else:
            try:
                request = urllib.request.Request(repo.rstrip("/") + "/info/refs?service=git-upload-pack", headers={"User-Agent": "silo-metal/1"})
                with urllib.request.urlopen(request, timeout=30) as stream:
                    advertisement = stream.read(4 * 1024 * 1024).decode("utf-8", errors="replace")
                match = re.search(r"([0-9a-f]{40}) " + re.escape(ref) + r"(?:\x00|\n)", advertisement)
                if match:
                    return match[1]
            except (OSError, ValueError):
                pass
    refuse("METAL_REPO_UNREACHABLE", "repository branch unavailable; configure access locally without credentials in URLs")

def preflight(allow):
    result = os_check(allow)
    result["installer_companions"] = companions()
    result["cpus"] = os.cpu_count()
    mem = re.search(r"MemTotal:\s+(\d+)", Path("/proc/meminfo").read_text())
    result["ram_bytes"] = int(mem[1]) * 1024
    memory = {k: int(v) * 1024 for k,v in re.findall(r"^(MemAvailable|SwapTotal|SwapFree):\s+(\d+)", Path("/proc/meminfo").read_text(), re.M)}
    result["available_ram_bytes"] = memory.get("MemAvailable", 0)
    result["capacity_ok"] = result["cpus"] >= 4 and result["available_ram_bytes"] >= int(C["VERIFY_MIN_AVAILABLE_MIB"]) * 1024**2
    result["load_average"] = list(os.getloadavg())
    cores = set()
    for block in Path("/proc/cpuinfo").read_text().split("\n\n"):
        physical = re.search(r"^physical id\s*:\s*(.+)$", block, re.M)
        core = re.search(r"^core id\s*:\s*(.+)$", block, re.M)
        if physical and core:
            cores.add((physical[1], core[1]))
    result["physical_cores"] = len(cores) or None
    result["logical_cpus"] = result["cpus"]
    result["swap"] = {"total_bytes": memory.get("SwapTotal", 0), "used_bytes": memory.get("SwapTotal", 0) - memory.get("SwapFree", 0),
                      "vmstat_1_3": output(["vmstat", "1", "3"], timeout=8)}
    tmpuse = shutil.disk_usage("/tmp")
    result["tmp"] = {"filesystem": output(["findmnt", "-n", "-o", "FSTYPE", "--target", "/tmp"]),
                     "used_bytes": tmpuse.used, "free_bytes": tmpuse.free, "total_bytes": tmpuse.total}
    result["warnings"] = ["Shared-host CPU, load, swap and container caps are informational; admission is not sized against other workloads."]
    if not result["capacity_ok"]:
        result["warnings"].append("Below migration capacity: >=4 logical CPUs and >=8 GiB AVAILABLE RAM required for full verify, not shell-only install.")
    result["disks"] = {str(path): {"free_bytes": shutil.disk_usage(ancestor(path)).free,
        "required_bytes": 48 * 1024**3} for path in (P, W)}
    result["capacity_ok"] = result["capacity_ok"] and all(d["free_bytes"] >= d["required_bytes"] for d in result["disks"].values())
    result["docker"] = {"binary": shutil.which("docker"), "version": output(["docker", "--version"]),
        "storage_driver": output(["docker", "info", "--format", "{{.Driver}}"]),
        "running_container_count": output(["docker", "info", "--format", "{{.ContainersRunning}}"]),
        "docker_io": installed("docker.io"), "docker_ce": installed("docker-ce")}
    ids = output(["docker", "ps", "-q"])
    caps = output(["docker", "inspect", "--format", "{{.HostConfig.NanoCpus}} {{.HostConfig.CpuQuota}} {{.HostConfig.CpuPeriod}} {{.HostConfig.Memory}}"] + ids.split()) if ids else None
    totals = {"cpu_limit_sum": 0.0, "memory_limit_bytes_sum": 0, "uncapped_cpu": 0, "uncapped_memory": 0}
    if caps:
        for line in caps.splitlines():
            nano, quota, period, memory = map(int, line.split())
            cpu = nano / 1e9 if nano > 0 else quota / period if quota > 0 and period > 0 else 0
            totals["cpu_limit_sum"] += cpu
            totals["memory_limit_bytes_sum"] += max(memory, 0)
            totals["uncapped_cpu"] += int(cpu == 0)
            totals["uncapped_memory"] += int(memory <= 0)
    result["docker"]["running_container_limit_totals"] = totals if caps or ids == "" else None
    low, high = map(int, C["PORT_RANGE"].split("-"))
    result["occupied_ports"] = [port for port in sorted(set(range(low, high + 1)) | {int(C["TERM_LLM_PORT"])}) if occupied(port)]
    entry = account_entry()
    result["account"] = {"exists": bool(entry), "home": str(home()), "groups": output(["id", "-nG", C["SILO_ACCOUNT"]])}
    result["paths"] = {str(p): path_state(p) for p in (P, W, home(), home()/".config/term-llm", home()/".local/share/term-llm", home()/".config/systemd/user/term-llm-web.service", P/"bin/term-llm")}
    result["account_term_llm"] = {str(path): path_state(path) for path in (home()/".local/bin/term-llm", P/"bin/term-llm")}  # Never sudo in preflight.
    result["linger"] = Path("/var/lib/systemd/linger", C["SILO_ACCOUNT"]).exists()
    result["missing_packages"] = missing_packages()
    result["repos"] = {}
    for key, branch in (("SILO_REPO", "SILO_BRANCH"), ("CONVERTER_REPO", "CONVERTER_BRANCH"), ("CONVERTER_REPO", "VERIFY_CONVERTER_BRANCH")):
        try:
            result["repos"][branch] = {"reachable": True, "commit": resolve(C[key], C[branch])}
        except Refusal:
            result["repos"][branch] = {"reachable": False}
    return result

def module(name, filename):
    from importlib.machinery import SourceFileLoader
    loader = SourceFileLoader(name, str(SELF.parent / filename))
    spec = importlib.util.spec_from_loader(name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod

def artifact():
    if not C["ARTIFACT_PACKAGE"]:
        return None
    pack = module("package_artifacts", "package-artifacts")
    try:
        manifest = pack.verify(C["ARTIFACT_PACKAGE"])
    except (pack.Invalid, OSError, ValueError, TypeError, AttributeError, KeyError, AssertionError, tarfile.TarError):
        refuse("METAL_ARTIFACT_INVALID", "verify the allowlisted package before applying; no images loaded")
    return dict(id=sha(Path(C["ARTIFACT_PACKAGE"])/"manifest.json"), sha256=sha(Path(C["ARTIFACT_PACKAGE"])/"SHA256SUMS"), manifest=manifest)

def service_args(dry=False):
    # Only the secrets file PATH is passed; term-llm imports it into its private store.
    secrets = ["--secrets-file", C["HUB_SECRETS_FILE"]] if C["HUB_URL"] else []
    hub = (["--hub-url", C["HUB_URL"], "--hub-node-id", C["HUB_NODE_ID"]] + (["--hub-node-name", C["HUB_NODE_NAME"]] if C["HUB_NODE_NAME"] else [])
           + ["--hub-connect", "reverse", "--hub-register"]) if C["HUB_URL"] else []
    return ([str(P/"bin/term-llm"), "service", "install", "web", "--binary", str(P/"bin/term-llm"), "--no-start"] + (["--dry-run"] if dry else []) + secrets
            + ["--", "--host", "127.0.0.1", "--port", C["TERM_LLM_PORT"], "--auth", "bearer", "--approval", "prompt", "--no-projects", "--disable-extensions", "--disable-widgets"] + hub)

def hub_secrets_state(entry):
    # Metadata only: the file holds TERM_LLM_HUB_REGISTRATION_TOKEN and is never read or hashed here.
    if not C["HUB_URL"]:
        return None
    if not entry:
        refuse("METAL_HUB_ORDER", "install without HUB_* first, then create HUB_SECRETS_FILE as the service account and re-plan")
    path = Path(C["HUB_SECRETS_FILE"])
    try:
        info = path.lstat()
    except FileNotFoundError:
        refuse("METAL_HUB_SECRETS", "HUB_SECRETS_FILE missing; create it as the service account (mode 0600)")
    except PermissionError:
        refuse("METAL_HUB_SECRETS", "HUB_SECRETS_FILE unreadable for inspection; check its directory permissions")
    if not stat.S_ISREG(info.st_mode) or info.st_uid != entry.pw_uid or info.st_mode & 0o077 or info.st_nlink != 1:
        refuse("METAL_HUB_SECRETS", "HUB_SECRETS_FILE must be a regular single-link file owned by the service account, mode 0600")
    directory_authority([path.parent])
    return {"path": str(path), "uid": info.st_uid, "mode": oct(info.st_mode & 0o7777), "size": info.st_size, "mtime_ns": info.st_mtime_ns}

MIGRATION_AGENTS = ("migration-analyst", "migration-operator", "server-support")
AGENTS_HELP = ("the service account's term-llm config.yaml needs 'agents:' with 'use_builtin: false' and "
               "'search_paths:' containing the installed agents directory, so the web UI offers only the node's agents")

def agents_ready(as_account=True):
    # Without --agent the web UI offers every agent term-llm lists, so require exactly
    # the node's agents: no built-in shell agents with Docker authority. server-support's
    # shell and edits are prompt-approved per action (service --approval prompt).
    listing = output([P/"bin/term-llm", "agents"], account=as_account)
    if not listing or "[builtin]" in listing or not re.search(r"Available agents \(" + str(len(MIGRATION_AGENTS)) + r"\):", listing):
        return False
    return all(re.search(r"(?m)^\s+" + re.escape(name) + r" - ", listing) for name in MIGRATION_AGENTS)

def make_plan(allow=False):
    osinfo = os_check(allow)
    if osinfo["errors"]:
        refuse("METAL_PREFLIGHT_REFUSED", "; ".join(osinfo["errors"]))
    commit = resolve(C["SILO_REPO"], C["SILO_BRANCH"])
    package = artifact()
    entry = account_entry()
    if entry and (entry.pw_uid == 0 or entry.pw_dir != "/home/" + C["SILO_ACCOUNT"] or entry.pw_shell != "/bin/bash"):
        refuse("METAL_ACCOUNT_CONFLICT", "existing account must be non-root, use /home/ACCOUNT and /bin/bash; no automatic account modification")
    roots, users = [], []
    missing = missing_packages()
    if missing:
        roots += [{"action": "packages", "packages": missing, "detail": "apt-get update; apt-get install -y --no-upgrade (only missing packages; --no-upgrade does not pin dependencies or prevent new dependency installs and maintainer scripts/services)"}]
    docker = bool(shutil.which("docker"))
    if not docker:
        if C["DOCKER_INSTALL"] == "never":
            refuse("METAL_DOCKER_REQUIRED", "Docker absent and installation forbidden")
        conflicts = [p for p in ("docker.io", "docker-ce", "containerd", "runc", "podman-docker") if installed(p)]
        if conflicts:
            refuse("METAL_DOCKER_CONFLICT", "existing Docker/container runtime packages preserved; resolve missing Docker binary manually")
        if osinfo["id"] != "debian" or osinfo["version"] != "12":
            refuse("METAL_DOCKER_OS_UNTESTED", "automatic official Debian Docker CE install supported on Debian 12 only")
        for path in ("/etc/apt/keyrings/docker.asc", "/etc/apt/sources.list.d/docker.list"):
            if os.path.lexists(path):
                refuse("METAL_DOCKER_REPO_CONFLICT", "existing Docker key/repository preserved; inspect manually")
        roots += [{"action": "docker", "detail": "official Docker Debian bookworm signed-by repository; install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin; never remove/replace existing runtime; pinned key fingerprint 9DC858229FC7DD38854AE2D88D81803C0EBFCD88; apt maintainer scripts enable/start Docker/containerd and Docker may change iptables/nftables forwarding/NAT rules; --no-upgrade does not pin dependencies"}]
    if not entry:
        roots += [{"action": "account", "detail": "useradd --create-home --home-dir /home/" + C["SILO_ACCOUNT"] + " --shell /bin/bash " + C["SILO_ACCOUNT"]}]
    groups = output(["id", "-nG", C["SILO_ACCOUNT"]]) or ""
    if "docker" not in groups.split():
        roots += [{"action": "group", "detail": "add account to docker group: ROOT-EQUIVALENT authority; an already running user manager must be restarted separately to acquire new supplementary groups"}]
    dirs = [P, W] + [P/p for p in ("bin", "etc", "releases", "term-llm", "control", "control/gems", "control/site-cache", "state", "state/logs", "state/tmp", "state/runtime-profiles")]
    account_dirs = [home()/part for part in (".config", ".config/term-llm", ".config/term-llm/agents",
        ".config/term-llm/services/web", ".config/systemd/user", ".local/share/term-llm")]
    authority = directory_authority(dirs + account_dirs + [P/"term-llm"/C["TERM_LLM_VERSION"]])
    if C["ARTIFACT_PACKAGE"]:
        authority.update(directory_authority([Path(C["ARTIFACT_PACKAGE"])]))
    for path in dirs:
        if path.is_symlink():
            refuse("METAL_PATH_CONFLICT", "managed directory is a symlink; inspect ownership manually")
        if path.exists() and (not path.is_dir() or not entry or path.stat().st_uid != entry.pw_uid):
            refuse("METAL_PATH_CONFLICT", "existing managed directories must be owned by service account; never recursively chown existing data")
        if not path.exists() or path.stat().st_mode & 0o777 != 0o750:
            roots += [{"action": "directory", "path": str(path), "detail": "install directory owner=" + C["SILO_ACCOUNT"] + " mode=0750"}]
    if C["TERM_LLM_SERVICE"] != "skip" and not Path("/var/lib/systemd/linger", C["SILO_ACCOUNT"]).exists():
        roots += [{"action": "linger", "detail": "loginctl enable-linger " + C["SILO_ACCOUNT"]}]
    versiondir = P/"term-llm"/C["TERM_LLM_VERSION"]
    if (versiondir/"term-llm").exists() and ((versiondir/"binary.sha256").is_file() and (versiondir/"binary.sha256").read_text().strip() != sha(versiondir/"term-llm")):
        refuse("METAL_TERM_UNVERIFIED", "installed binary differs from verified receipt; preserve and inspect manually")
    state_paths = [versiondir/"binary.sha256", versiondir/"term-llm", P/"current", P/"previous", P/"state/install-manifest.json", P/"bin/term-llm", P/"bin/silo-migrate-control", P/"etc/silo-control.env", home()/".config/term-llm", home()/".config/term-llm/config.yaml", home()/".config/systemd/user/term-llm-web.service"]
    state = {str(p): path_state(p) for p in state_paths}
    target = {"silo_repo": C["SILO_REPO"], "branch": C["SILO_BRANCH"], "commit": commit,
              "term_llm_version": C["TERM_LLM_VERSION"], "term_llm_sha256": PIN,
              "config_sha256": digest_bytes(canonical(C).encode()), "artifact_package": package}
    old = load(P/"state/install-manifest.json") if (P/"state/install-manifest.json").is_file() else {}
    image_steps = []
    image_inventory = {}
    image_repair = False
    if package:
        identity = module("image_identity", "image_identity.py")
        packaged = {i["role"]: i for i in package["manifest"]["images"]}
        profile_images = load(Path(C["ARTIFACT_PACKAGE"])/"profile.json")["images"]
        for role, image in sorted(profile_images.items()):
            resolved_ref, inspected = inspect_image(image)
            observed = json.loads(inspected) if inspected else None
            local = {"local_id": observed[0]["Id"], "content_id": identity.content_id(observed)} if observed else None
            image_inventory[role] = local
            if local and local["content_id"] == image["content_id"]:
                image_steps.append("verify existing " + role + " " + image["ref"] + " " + image["content_id"])
            else:
                image_repair = True
                if role in packaged:
                    image_steps.append("docker image load --input " + str(Path(C["ARTIFACT_PACKAGE"])/packaged[role]["file"]) + " sha256=" + packaged[role]["sha256"])
                else:
                    image_steps.append("docker pull --platform linux/amd64 " + image["ref"])
                image_steps.append("require " + role + " content_id=" + image["content_id"])
        image_steps.append("extract gems.tar.gz to " + str(P/"control/gems"/package["manifest"]["gems"]["sha256"]) + "; install site_settings.yml cache FILE")
    state["image_inventory"] = image_inventory
    needs = image_repair or any(old.get(k) != v for k,v in target.items()) or not (P/"current").exists() or not (P/"bin/term-llm").exists() or not (P/"bin/silo-migrate-control").exists() or (P/"current").resolve() != P/"releases"/commit
    if needs:
        users = [
            {"action": "term-llm", "detail": ("verify existing version/binary receipts (download skipped); ensure bin symlink" if (versiondir/"term-llm").exists() else "download https://github.com/samsaffron/term-llm/releases/download/v0.9.93/term-llm_0.9.93_linux_amd64.tar.gz; verify pinned SHA256 " + PIN + " AND release checksums.txt; install version directory and atomic bin symlink")},
            {"action": "release", "detail": ("verify clean detached release (clone skipped): " if (P/"releases"/commit).exists() else "clone detached commit into ") + str(P/"releases"/commit) + "; validate release profile against package"},
            {"action": "artifacts", "detail": "verify SHA256SUMS/profile; " + "; ".join(image_steps) if package else "SKIPPED: no ARTIFACT_PACKAGE; shell/service install only, NOT migration-ready"},
            {"action": "configuration", "detail": "write control env and shim; fresh term-llm config/data only if absent; preserve existing account config; link operator/analyst (refuse conflicts); atomic current switch"}]
        if C["TERM_LLM_SERVICE"] != "skip":
            users += [{"action": "service", "argv": service_args(), "detail": "verify flags against pinned binary help; install no-start; preserve unmanaged units; write systemd user drop-in Environment SILO_CONTROL=" + str(P/"bin/silo-migrate-control") + " SILO_CONTROL_CONFIG=" + str(P/"etc/silo-control.env") + " TMPDIR=" + str(P/"state/tmp") + "; daemon-reload (no start)"}]
            if C["TERM_LLM_SERVICE"] == "install-and-start":
                users += [{"action": "start", "detail": "term-llm service start web (enable/start requested)"}]
        users += [{"action": "manifest", "detail": "atomic install-manifest.json plus append history.jsonl (hashes, image identities, timestamps)"}]
    hub_notes = (["Hub reverse registration ENABLED for node " + C["HUB_NODE_ID"] + " at " + C["HUB_URL"] + ": the node dials out; anyone with access to that Hub can operate this node's agents with the service account's ROOT-EQUIVALENT Docker authority.",
                  "If the web service is already running, restart it as the account after apply (term-llm service restart web) for Hub flags to take effect."]
                 if C["HUB_URL"] else ["No Hub registration (opt-in via HUB_URL, HUB_NODE_ID, HUB_SECRETS_FILE)."])
    notes = hub_notes + [
             "No provider credentials, sessions or memory copied. Use account-local auth / service install --secret NAME masked prompts.",
             "Confirmed config keys: approval.default_mode, serve.approval_mode, serve.extensions, serve.auto_title, provider_discovery, serve.projects.enabled.",
             "No confirmed config keys to disable widgets or automatic memory mining. Use confirmed --disable-widgets/--disable-extensions flags; register no jobs/mining automation.",
             "Capacity gate for actual migration: 4 CPUs, 8 GiB RAM, 40 GiB new + 8 GiB reserve on each relevant filesystem."]
    if (home()/".config/term-llm").exists():
        notes.append("Existing term-llm config directory PRESERVED; safety/routing of existing config requires engineer review before customer use.")
    if C["TERM_LLM_SERVICE"] != "skip" and (P/"bin/term-llm").exists() and (home()/".config/term-llm/config.yaml").exists() and entry \
            and (P/"current").exists() and not agents_ready():
        refuse("METAL_AGENTS_CONFIG", "existing term-llm config preserved; " + AGENTS_HELP + " (" + agents_path() + "), then re-plan")
    notes.append("Web UI agent picker: only " + ", ".join(sorted(MIGRATION_AGENTS)) + ", from " + agents_path() + " (agents.use_builtin: false); no pinned startup agent.")
    notes.append("server-support has a shell with the account's ROOT-EQUIVALENT Docker authority and built-in file edits; each command and each write needs approval in the web UI (--approval prompt). Its read tools refuse workspaces, state/tmp and credential files.")
    dry = None
    binary = P/"bin/term-llm"
    if C["TERM_LLM_SERVICE"] != "skip" and binary.exists() and entry:
        dry = output(service_args(True), account=True)
        if dry is None:
            refuse("METAL_SERVICE_PREVIEW_FAILED", "stock service install --dry-run failed; inspect existing account state")
        # Output intentionally not copied: native definitions can expose paths/credential names.
        dry = digest_bytes(dry.encode())
    elif C["TERM_LLM_SERVICE"] != "skip":
        notes.append("Stock service install --dry-run deferred: pinned binary/account absent; apply runs dry-run before service writes.")
    return {"format_version": 1, "config": C, "target": target, "state": dict(state, directory_authority=authority), "os": osinfo, "installer_sha256": sha(SELF),
            "companion_sha256": companions(), "hub_secrets": hub_secrets_state(entry), "needs_root": roots, "as_account": users, "notes": notes, "service_preview_sha256": dry}

def computed_plan(args):
    entry = account_entry()
    if entry and os.geteuid() not in (0, entry.pw_uid):
        opts = (["--config", str(Path(args.config).resolve())] if args.config else []) + (["--allow-untested-os"] if args.allow_untested_os else [])
        result = run([SELF, "plan", "--json"] + opts, account=True)
        return json.loads(result.stdout)["plan"]
    return make_plan(args.allow_untested_os)

def envelope(plan):
    return {"sha256": digest_bytes(canonical(plan).encode()), "plan": plan}

def atomic_write(path, data, mode=0o640):
    path = Path(path)
    if path.is_symlink():
        refuse("METAL_PATH_CONFLICT", "refusing to overwrite symlink")
    fd, tmp = tempfile.mkstemp(prefix=".metal-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)

def symlink(target, link):
    link = Path(link)
    if link.is_symlink() and os.readlink(link) == str(target):
        return
    if link.exists() and not link.is_symlink():
        refuse("METAL_PATH_CONFLICT", "managed link conflicts with an existing non-symlink")
    temp = link.with_name(".metal-link-" + str(os.getpid()))
    for stale in link.parent.glob(".metal-link-*"):
        if stale.is_symlink() and stale.lstat().st_uid == os.geteuid():
            stale.unlink()
    try:
        os.symlink(str(target), temp)
        os.replace(temp, link)
    finally:
        if temp.is_symlink():
            temp.unlink()

def apply_roots(actions):
    for action in actions:
        kind = action["action"]
        if kind == "packages":
            run(["apt-get", "update"], root=True, timeout=600)
            run(["apt-get", "install", "-y", "--no-upgrade", "--no-remove"] + action["packages"], root=True, timeout=600)
        elif kind == "docker":
            # Same signed-by Debian repository route as script/install, no distro replacement/removal.
            if shutil.which("docker"):
                refuse("METAL_PLAN_STALE", "Docker appeared after planning; re-plan")
            for path in ("/etc/apt/keyrings/docker.asc", "/etc/apt/sources.list.d/docker.list"):
                if os.path.lexists(path):
                    refuse("METAL_DOCKER_REPO_CONFLICT", "existing Docker key/repository preserved")
            # Download and verify in the approved filesystem, never /tmp.
            with tempfile.TemporaryDirectory(dir=P/"state/tmp", prefix="docker-key-") as temporary:
                key = Path(temporary)/"docker.asc"
                run(["curl", "-fsSL", "https://download.docker.com/linux/debian/gpg", "-o", key])
                info = output(["gpg", "--batch", "--homedir", temporary, "--with-colons", "--show-keys", key]) or ""
                primary = [line.split(":")[9] for line in info.splitlines() if line.startswith("fpr:")]
                if not primary or primary[0] != "9DC858229FC7DD38854AE2D88D81803C0EBFCD88" or sum(line.startswith("pub:") for line in info.splitlines()) != 1:
                    refuse("METAL_DOCKER_KEY", "Docker signing key fingerprint mismatch")
                Path("/etc/apt/keyrings").mkdir(mode=0o755, exist_ok=True)
                with open("/etc/apt/keyrings/docker.asc", "xb") as out:
                    out.write(key.read_bytes())
                os.chmod("/etc/apt/keyrings/docker.asc", 0o644)
            repo = "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable\n"
            with open("/etc/apt/sources.list.d/docker.list", "x") as out:
                out.write(repo)
            run(["apt-get", "update"], root=True, timeout=600)
            run(["apt-get", "install", "-y", "--no-upgrade", "--no-remove", "docker-ce", "docker-ce-cli", "containerd.io", "docker-buildx-plugin", "docker-compose-plugin"], root=True, timeout=900)
        elif kind == "account":
            run(["useradd", "--create-home", "--home-dir", "/home/" + C["SILO_ACCOUNT"], "--shell", "/bin/bash", C["SILO_ACCOUNT"]], root=True)
        elif kind == "group":
            if not output(["getent", "group", "docker"]):
                run(["groupadd", "--system", "docker"], root=True)
            run(["usermod", "-aG", "docker", C["SILO_ACCOUNT"]], root=True)
        elif kind == "directory":
            entry = pwd.getpwnam(C["SILO_ACCOUNT"])
            secure_directory(action["path"], entry.pw_uid, entry.pw_gid)
        elif kind == "linger":
            run(["loginctl", "enable-linger", C["SILO_ACCOUNT"]], root=True)


def fetch_release(commit):
    global STAGE
    release = P/"releases"/commit
    if not release.exists():
        stage = Path(tempfile.mkdtemp(prefix=".release-", dir=P/"state/tmp"))
        try:
            local = (["--no-local", "--upload-pack=git -c " + shlex.quote("safe.directory=" + C["SILO_REPO"]) + " upload-pack"] if C["SILO_REPO"].startswith("/") else [])
            run(["git", "-c", "credential.helper=", "-c", "core.hooksPath=/dev/null", "clone", "--no-hardlinks", "--no-checkout"] + local + ["--", C["SILO_REPO"], stage], timeout=600)
            STAGE = "RELEASE_CHECKOUT"
            run(["git", "-c", "core.hooksPath=/dev/null", "-C", stage, "checkout", "--detach", commit])
            os.chmod(stage, 0o750)
            os.replace(stage, release)
        finally:
            if stage.exists():
                shutil.rmtree(stage)
    if git(["-C", str(release), "rev-parse", "HEAD"]) != commit or git(["-C", str(release), "status", "--porcelain"]):
        refuse("METAL_RELEASE_DIRTY", "release checkout must match exact clean commit; preserve and inspect it manually")
    return release

def install_term():
    version = C["TERM_LLM_VERSION"]
    dest = P/"term-llm"/version/"term-llm"
    if not dest.exists():
        asset = "term-llm_" + version + "_linux_amd64.tar.gz"
        base = "https://github.com/samsaffron/term-llm/releases/download/v" + version + "/"
        with tempfile.TemporaryDirectory(prefix=".download-", dir=P/"state/tmp") as tmp:
            archive = Path(tmp)/asset
            sums = Path(tmp)/"checksums.txt"
            for name in (asset, "checksums.txt"):
                run(["curl", "-fsSL", "--proto", "=https", "--tlsv1.2", base + name, "-o", Path(tmp)/name], timeout=600)
            actual = sha(archive)
            matches = [line.split()[0] for line in sums.read_text().splitlines() if len(line.split()) == 2 and line.split()[1].lstrip("*") == asset]
            if actual != PIN or matches != [PIN]:
                refuse("METAL_TERM_CHECKSUM", "release tarball must match pinned AND release checksum; no binary installed")
            with tarfile.open(archive, "r:gz") as tar:
                binaries = [m for m in tar.getmembers() if m.name in ("term-llm", "./term-llm") and m.isfile()]
                if len(binaries) != 1:
                    refuse("METAL_TERM_ARCHIVE", "release archive must contain exactly one regular term-llm binary")
                dest.parent.mkdir(mode=0o750)
                with tar.extractfile(binaries[0]) as src, open(dest, "xb") as out:
                    shutil.copyfileobj(src, out)
                dest.chmod(0o750)
            atomic_write(dest.parent/"archive.sha256", PIN + "\n")
            atomic_write(dest.parent/"binary.sha256", sha(dest) + "\n")
    if not (dest.parent/"archive.sha256").is_file() or (dest.parent/"archive.sha256").read_text().strip() != PIN:
        refuse("METAL_TERM_UNVERIFIED", "existing version lacks checksum receipt; preserve and inspect manually")
    if not (dest.parent/"binary.sha256").is_file() or (dest.parent/"binary.sha256").read_text().strip() != sha(dest):
        refuse("METAL_TERM_UNVERIFIED", "installed binary hash differs from download receipt; preserve and investigate")
    old = P/"bin/term-llm"
    if old.is_symlink() and old.resolve() != dest:
        symlink(old.resolve(), P/"bin/term-llm.previous")
    symlink(dest, old)
    if "0.9.93" not in (output([dest, "--version"]) or ""):
        refuse("METAL_TERM_VERSION", "downloaded binary version mismatch")
    install_help = output([dest, "service", "install", "--help"]) or ""
    serve_help = output([dest, "serve", "--help"]) or ""
    for flag in ("--binary", "--no-start", "--dry-run"):
        if flag not in install_help:
            refuse("METAL_TERM_FLAGS", "pinned service help does not support required flags")
    for flag in ("--host", "--port", "--auth", "--approval", "--agent", "--no-projects", "--disable-extensions", "--disable-widgets"):
        if flag not in serve_help:
            refuse("METAL_TERM_FLAGS", "pinned serve help does not support required flags")

def inspect_image(image):
    ref = image["ref"]
    inspected = output(["docker", "image", "inspect", ref])
    if not inspected and "@sha256:" in ref:
        ref = "silo-migrate/loaded:" + image["content_id"][7:]
        inspected = output(["docker", "image", "inspect", ref])
    return ref, inspected

def image_tags():
    listing = output(["docker", "image", "ls", "--no-trunc", "--format", "{{.Repository}}:{{.Tag}} {{.ID}}"])
    if listing is None:
        refuse("METAL_IMAGE_INVENTORY", "cannot snapshot Docker image tags")
    return dict(line.split() for line in listing.splitlines() if not line.startswith("<none>:") and ":<none> " not in line)

def extract_artifacts(release, package):
    if not package:
        return [], "skipped-no-package", ""
    directory_authority([Path(C["ARTIFACT_PACKAGE"])])
    # Private account-owned snapshot on the prefix filesystem. Only this copy is
    # verified/loaded/extracted, and TemporaryDirectory cleans it on every exit.
    with tempfile.TemporaryDirectory(prefix="package-", dir=P/"state/tmp") as stage:
        os.chmod(stage, 0o700)
        root = Path(stage)/"package"
        shutil.copytree(C["ARTIFACT_PACKAGE"], root, symlinks=True)
        return extract_artifact_copy(release, package, root)

def extract_artifact_copy(release, package, root):
    if not package:
        return [], "skipped-no-package", ""
    pack = module("package_artifacts", "package-artifacts")
    name = package["manifest"]["profile"]["name"]
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}", name):
        refuse("METAL_ARTIFACT_INVALID", "invalid bound profile filename")
    profile = release/"runtime/profiles"/(name + ".json")
    try:
        manifest = pack.verify(root, profile)
    except (pack.Invalid, OSError, ValueError, TypeError, AttributeError, KeyError, AssertionError, tarfile.TarError):
        refuse("METAL_ARTIFACT_INVALID", "package/release profile mismatch; no images loaded")
    if sha(root/"manifest.json") != package["id"] or sha(root/"SHA256SUMS") != package["sha256"]:
        refuse("METAL_PLAN_STALE", "artifact package changed; re-plan")
    images = pack.profile_read(profile)["images"]
    packaged = {item["role"]: item for item in manifest["images"]}
    identity = module("image_identity", "image_identity.py")
    receipts = []
    for role, image in images.items():
        resolved_ref, existing = inspect_image(image)
        valid = existing and identity.content_id(json.loads(existing)) == image["content_id"]
        if not valid:
            if role in packaged:
                resolved_ref = image["ref"]
                parser = module("image_archive", "image_archive.py")
                try:
                    loaded_id = parser.validate(root/packaged[role]["file"], image, identity)
                except (ValueError, KeyError, TypeError, tarfile.TarError):
                    refuse("METAL_IMAGE_ARCHIVE", "archive must contain exactly the bound image and no foreign tags; nothing loaded")
                before = image_tags()
                loaded = run(["docker", "image", "load", "--input", root/packaged[role]["file"]], timeout=3600, check=False)
                after = image_tags()
                if {k:v for k,v in before.items() if k != image["ref"]} != {k:v for k,v in after.items() if k != image["ref"]}:
                    refuse("METAL_IMAGE_TAG_CHANGED", "Docker load changed another tag; inspect daemon locally; no automatic tag repair")
                if not loaded or loaded.returncode:
                    refuse("METAL_IMAGE_LOAD", "Docker load failed; tag snapshot checked; inspect daemon locally (raw output suppressed)")
                # Docker load does not recreate registry RepoDigests. Resolve by
                # validated config ID/content, not by claiming the digest ref exists.
                if "@sha256:" in image["ref"] and not output(["docker", "image", "inspect", image["ref"]]):
                    observed = json.loads(output(["docker", "image", "inspect", loaded_id]) or "null")
                    if not observed or identity.content_id(observed) != image["content_id"]:
                        refuse("METAL_IMAGE_IDENTITY", "loaded image identity mismatch")
                    local_ref = "silo-migrate/loaded:" + image["content_id"][7:]
                    old_tag = after.get(local_ref)
                    if old_tag and old_tag != loaded_id:
                        refuse("METAL_IMAGE_TAG_CHANGED", "deterministic local tag already refers to another image")
                    run(["docker", "image", "tag", loaded_id, local_ref])
                    resolved_ref = local_ref
            elif image["source"] == "public-digest":
                resolved_ref = image["ref"]
                run(["docker", "pull", "--platform", "linux/amd64", image["ref"]], timeout=3600)
            else:
                refuse("METAL_IMAGE_MISSING", "required package image unavailable")
        inspect = json.loads(output(["docker", "image", "inspect", resolved_ref]) or "null")
        if not inspect or identity.content_id(inspect) != image["content_id"]:
            refuse("METAL_IMAGE_IDENTITY", "image content_id mismatch; preserve package and investigate")
        receipts.append(dict(role=role, ref=image["ref"], resolved_ref=resolved_ref, content_id=image["content_id"], local_id=inspect[0]["Id"]))
    gemsha = manifest["gems"]["sha256"]
    gems = P/"control/gems"/gemsha
    if not gems.exists():
        temp = Path(tempfile.mkdtemp(prefix=".gems-", dir=P/"state/tmp"))
        try:
            with tarfile.open(root/"gems.tar.gz", "r:gz") as tar:
                # Explicit extraction works on Debian's Python 3.11 too. The
                # verifier rejects links, traversal, duplicates and special files.
                seen = set()
                for member in tar.getmembers():
                    if not pack.safe_name(member.name) or not (member.isfile() or member.isdir()) or member.name.rstrip("/") in seen:
                        refuse("METAL_ARTIFACT_INVALID", "unsafe or duplicate gem archive member")
                    seen.add(member.name.rstrip("/"))
                    dest = temp/member.name
                    if member.isdir():
                        dest.mkdir(parents=True, exist_ok=True, mode=0o750)
                    else:
                        dest.parent.mkdir(parents=True, exist_ok=True, mode=0o750)
                        with tar.extractfile(member) as src, open(dest, "xb") as out:
                            shutil.copyfileobj(src, out)
                        dest.chmod(0o750 if member.mode & 0o111 else 0o640)
            os.replace(temp, gems)
        finally:
            if temp.exists():
                shutil.rmtree(temp)
    site = P/"control/site-cache/site_settings.yml"
    if site.exists() and sha(site) != manifest["site_settings"]["sha256"]:
        refuse("METAL_SITE_CACHE_CONFLICT", "existing site settings preserved; inspect manually")
    if not site.exists():
        shutil.copyfile(root/"site_settings.yml", site)
        site.chmod(0o640)
    return receipts, "verified", str(gems)

def record(target, operation, previous=None, **extra):
    manifest = dict(target, operation=operation, installed_at=now(), previous_commit=previous, **extra)
    atomic_write(P/"state/install-manifest.json", json.dumps(manifest, sort_keys=True, indent=2) + "\n")
    history = P/"state/history.jsonl"
    if history.is_symlink():
        refuse("METAL_PATH_CONFLICT", "history symlink refused")
    with open(history, "a", encoding="utf-8") as stream:
        stream.write(canonical(manifest) + "\n")
    history.chmod(0o640)
    # Logs contain only fixed event labels and identities, never subprocess output/arguments.
    atomic_write(P/"state/logs"/(str(time.time_ns()) + ".json"), canonical({"at": now(), "event": operation, "commit": target["commit"], "result": "ok"}) + "\n")

def switch(release):
    current = P/"current"
    previous = current.resolve().name if current.is_symlink() else None
    if current.is_symlink() and current.resolve() == release:
        return (P/"previous").resolve().name if (P/"previous").is_symlink() else None
    if previous and current.resolve() != release:
        symlink(current.resolve(), P/"previous")
    symlink(release, current)
    return previous

COMPANIONS = ("package-artifacts", "image_identity.py", "image_archive.py")

def companions():
    # Helpers loaded from beside this script; a partial copy fails here, not mid-apply.
    found = {}
    for name in COMPANIONS:
        path = SELF.parent/name
        if path.is_symlink() or not path.is_file():
            refuse("METAL_INSTALLER_INCOMPLETE", "run from a checkout: script/" + name + " must sit beside script/metal")
        found[name] = sha(path)
    return found

def verify_installer(plan):
    if plan.get("installer_sha256") != sha(SELF) or plan.get("companion_sha256") != companions():
        refuse("METAL_PLAN_STALE", "installer changed; review a new plan")

@contextlib.contextmanager
def install_lock():
    path = P/"state/install.lock"
    directory_authority([path.parent])
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        entry = account_entry()
        if os.geteuid() == 0 and entry:
            os.fchown(fd, entry.pw_uid, entry.pw_gid)
        if not stat.S_ISREG(os.fstat(fd).st_mode) or os.fstat(fd).st_nlink != 1 or os.fstat(fd).st_uid not in ({0, entry.pw_uid} if entry else {0}) or os.fstat(fd).st_mode & 0o022:
            refuse("METAL_BUSY", "invalid installer lock")
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            refuse("METAL_BUSY", "another installer operation holds install.lock")
        yield
    finally:
        os.close(fd)

def account_apply(saved):
    global STAGE
    if os.geteuid() != pwd.getpwnam(C["SILO_ACCOUNT"]).pw_uid:
        refuse("METAL_ACCOUNT_REQUIRED", "account actions must run as configured service account")
    plan = saved["plan"]
    verify_installer(plan)
    STAGE = "TERM_DOWNLOAD"
    install_term()
    print("METAL_TERM_VERIFIED", flush=True)
    STAGE = "RELEASE_CLONE"
    release = fetch_release(plan["target"]["commit"])
    print("METAL_RELEASE_READY", flush=True)
    STAGE = "ARTIFACT_LOAD"
    images, image_state, gems = extract_artifacts(release, plan["target"]["artifact_package"])
    env = {"SILO_MIGRATE_BASE_PATH": str(W), "SILO_CONTROL_GEMS": gems or str(P/"control/gems/unavailable"),
           "SILO_CONTROL_SITE_CACHE": str(P/"control/site-cache/site_settings.yml"), "SILO_RUNTIME_PROFILES_DIR": str(P/"state/runtime-profiles")}
    atomic_write(P/"etc/silo-control.env", "".join(k + "=" + v + "\n" for k,v in env.items()))
    shim = '#!/bin/sh\nset -eu\nexport SILO_CONTROL_CONFIG=' + shlex.quote(str(P/"etc/silo-control.env")) + '\nexec ' + shlex.quote(str(P/"current/bin/silo-migrate-control")) + ' "$@"\n'
    atomic_write(P/"bin/silo-migrate-control", shim, 0o750)
    configdir = home()/".config/term-llm"
    if not configdir.exists():
        configdir.mkdir(parents=True, mode=0o700)
        atomic_write(configdir/"config.yaml", fresh_config(), 0o600)
    datadir = home()/".local/share/term-llm"
    if not datadir.exists():
        datadir.mkdir(parents=True, mode=0o700)
    agents = configdir/"agents"
    agents.mkdir(exist_ok=True, mode=0o700)
    for name in MIGRATION_AGENTS:
        dest = agents/name
        expected = P/"current/integrations/term-llm"/name
        # Agents come from the search path. Earlier installs linked them here; term-llm
        # skips symlinked folders when listing, so remove only those exact links.
        if dest.is_symlink() and os.readlink(dest) == str(expected):
            dest.unlink()
        elif dest.exists() or dest.is_symlink():
            refuse("METAL_AGENT_CONFLICT", "existing agent preserved; resolve name conflict manually")
    host_lock = W/".silo-standard-execution.lock"
    if not host_lock.exists():
        fd = os.open(host_lock, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        os.close(fd)
    previous = switch(release)
    if C["TERM_LLM_SERVICE"] != "skip":
        unit = home()/".config/systemd/user/term-llm-web.service"
        spec = configdir/"services/web/service.json"
        if unit.exists() and not spec.exists():
            refuse("METAL_SERVICE_CONFLICT", "existing unmanaged service preserved; migrate manually")
        STAGE = "SERVICE_PREVIEW"
        if not agents_ready(as_account=False):
            refuse("METAL_AGENTS_CONFIG", AGENTS_HELP + " (" + agents_path() + "); then re-plan")
        run(service_args(True))
        STAGE = "SERVICE_INSTALL"
        run(service_args())
        # Linked agent definitions otherwise resolve their relative control path
        # from ~/.config, and the adapter's child would miss installed config.
        # Non-secret OS environment only; no guessed term-llm config keys.
        dropdir = unit.with_name("term-llm-web.service.d")
        dropdir.mkdir(mode=0o700, exist_ok=True)
        dropin = dropdir/"50-silo-migrate.conf"
        environment = "[Service]\n" + "".join("Environment=" + key + "=" + value + "\n" for key,value in (
            ("SILO_CONTROL", str(P/"bin/silo-migrate-control")),
            ("SILO_CONTROL_CONFIG", str(P/"etc/silo-control.env")),
            ("TMPDIR", str(P/"state/tmp"))))
        if dropin.exists() and dropin.read_text() != environment:
            refuse("METAL_SERVICE_ENV_CONFLICT", "existing installer drop-in differs; inspect and resolve manually")
        if not dropin.exists():
            atomic_write(dropin, environment)
        run(["systemctl", "--user", "daemon-reload"])
        if C["TERM_LLM_SERVICE"] == "install-and-start":
            STAGE = "SERVICE_START"
            run([P/"bin/term-llm", "service", "start", "web"], timeout=180)
    record(plan["target"], "apply", previous, plan_sha256=saved["sha256"], images=images, image_verification=image_state)

@contextlib.contextmanager
def idle_guard():
    # Open existing locks read-only: status/update must never create workspace files.
    if not (W/".silo-standard-execution.lock").exists():
        refuse("METAL_BUSY", "host execution lock absent; finish initial apply before update/rollback")
    locks = [W/".silo-standard-execution.lock"] + sorted(W.glob("*/.silo-migrate/named/standard/op.lock"))
    opened = []
    try:
        for path in locks:
            if path.exists():
                if path.is_symlink():
                    refuse("METAL_BUSY", "workspace lock symlink refused; inspect state")
                fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
                opened.append(fd)
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    refuse("METAL_BUSY", "active execution/operation lock; wait for terminal state before update/rollback")
        for path in W.glob("*/.silo-migrate/named/standard/state.json"):
            state = load(path)
            if any(r.get("status") in ("claimed", "running") for r in state.get("runs", {}).values()):
                refuse("METAL_BUSY", "run claimed/running; recover or wait before update/rollback")
        yield
    finally:
        for fd in opened:
            os.close(fd)

def verify_release_images(release, bound):
    if not bound:
        return [], "skipped-no-package"
    name = bound["manifest"]["profile"]["name"]
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}", name):
        refuse("METAL_UPDATE_IMAGES", "invalid bound profile")
    profile = module("package_artifacts", "package-artifacts").profile_read(release/"runtime/profiles"/(name + ".json"))
    identity = module("image_identity", "image_identity.py")
    receipts = []
    for role, image in profile["images"].items():
        ref, observed = inspect_image(image)
        if not observed or identity.content_id(json.loads(observed)) != image["content_id"]:
            refuse("METAL_UPDATE_IMAGES", "bound profile requires unavailable/mismatched local images; no pull/load performed")
        receipts.append(dict(role=role, ref=image["ref"], resolved_ref=ref, content_id=image["content_id"], local_id=json.loads(observed)[0]["Id"]))
    return receipts, "verified"

def account_update(rollback=False, branch=None, term=False):
    with idle_guard():
        # Releases are cloned into, switched to and pruned from here: never via a link.
        if (P/"releases").is_symlink() or not (P/"releases").is_dir():
            refuse("METAL_PATH_CONFLICT", "releases directory is not a real directory; nothing changed")
        old = load(P/"state/install-manifest.json")
        if rollback:
            history = [json.loads(line) for line in (P/"state/history.jsonl").read_text().splitlines()]
            prev = old.get("previous_commit")
            if not prev or not any(item["commit"] == prev for item in history):
                refuse("METAL_NO_ROLLBACK", "no previous release recorded in history")
            release = P/"releases"/prev
            if not release.is_dir():
                refuse("METAL_NO_ROLLBACK", "previous release directory missing")
            target = next(item for item in reversed(history) if item["commit"] == prev).copy()
        else:
            selected = branch or C["SILO_BRANCH"]
            commit = resolve(C["SILO_REPO"], selected)
            if commit == old["commit"]:
                print("METAL_UNCHANGED")
                return
            release = fetch_release(commit)
            target = dict(old, commit=commit, branch=selected)
        bound = target.get("artifact_package")
        images, verification = verify_release_images(release, bound)
        target["images"] = images
        target["image_verification"] = verification
        if rollback and term:
            previous_bin = P/"bin/term-llm.previous"
            if not previous_bin.is_symlink() or not previous_bin.resolve().is_file():
                refuse("METAL_NO_TERM_ROLLBACK", "no previous term-llm version retained")
            active = (P/"bin/term-llm").resolve()
            symlink(previous_bin.resolve(), P/"bin/term-llm")
            symlink(active, previous_bin)
            target["term_llm_version"] = (P/"bin/term-llm").resolve().parent.name
        previous = switch(release)
        for key in ("installed_at", "operation", "previous_commit"):
            target.pop(key, None)
        record(target, "rollback" if rollback else "update", previous)
        if not rollback:
            protected = {release.name, (P/"previous").resolve().name}
            dirs = sorted((p for p in (P/"releases").iterdir() if p.is_dir() and not p.is_symlink() and re.fullmatch(r"[0-9a-f]{40}", p.name)), key=lambda p:p.stat().st_mtime, reverse=True)
            retained = set(protected)
            for path in dirs:
                if path.name in protected or len(retained) < int(C["KEEP_RELEASES"]):
                    retained.add(path.name)
                else:
                    shutil.rmtree(path)  # Exact managed release directories only, never workspaces/images/backups.
        print("METAL_ROLLBACK_OK" if rollback else "METAL_UPDATE_OK")

def control(args):
    print("METAL_VERIFY_STEP " + " ".join(a for a in args[:3] if not a.startswith("/")), file=sys.stderr)
    result = run([P/"bin/silo-migrate-control"] + args, account=True, timeout=600)
    try:
        return json.loads(result.stdout)
    except ValueError:
        refuse("METAL_VERIFY_PROTOCOL", "control command did not return structured JSON; inspect installed version")

def capacity_ready():
    available = re.search(r"^MemAvailable:\s+(\d+)", Path("/proc/meminfo").read_text(), re.M)
    return ((os.cpu_count() or 0) >= 4 and available and int(available[1]) * 1024 >= int(C["VERIFY_MIN_AVAILABLE_MIB"]) * 1024**2
            and all(shutil.disk_usage(ancestor(path)).free >= 48 * 1024**3 for path in (P, W)))

def verify(keep=False):
    if not capacity_ready():
        refuse("METAL_VERIFY_CAPACITY", "need >=4 logical CPUs, VERIFY_MIN_AVAILABLE_MIB available RAM and >=48 GiB free on prefix/workspaces; no workspace created")
    ws = "verify-" + datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S") + "-" + os.urandom(3).hex()
    runid = None
    try:
        control(["named", "init", ws])
        control(["converter", "clone", ws, "--repo", C["CONVERTER_REPO"], "--branch", C["VERIFY_CONVERTER_BRANCH"]])
        control(["standard", "init", ws])
        dataset = control(["standard", "fixture", "register", ws, "--snapshot", "development", "--label", "metal-verify", "--fixture-dir", str(W/ws/"converter/test/fixtures/khoros/inline_community_database")])
        plan = control(["standard", "plan", "propose", ws, "--dataset", dataset["dataset_id"], "--ports", C["PORT_RANGE"].split("-")[0] + "," + str(int(C["PORT_RANGE"].split("-")[0])+1)])
        control(["standard", "plan", "approve", ws, plan["plan_id"], "--sha256", plan["digest"], "--reviewer", "metal-verify (engineer-invoked)"])
        started = control(["start-run", ws, plan["plan_id"]])
        runid = started["run_id"]
        deadline = time.monotonic() + 3600
        while time.monotonic() < deadline:
            status = control(["standard", "status", ws])
            # The full status projection carries the latest run and final backup.
            current = next((r for r in status.get("runs", []) if r.get("run_id") == runid), {})
            if current.get("status") in ("failed", "abandoned", "not_started"):
                failure = current.get("failure") or {}
                code = failure.get("code") if re.fullmatch(r"STANDARD_[A-Z_]+", str(failure.get("code"))) else "unknown"
                stage = failure.get("stage") if re.fullmatch(r"[a-z_]+", str(failure.get("stage"))) else "unknown"
                refuse("METAL_VERIFY_RUN_FAILED", "run " + str(current.get("status")) + " at stage " + stage + " with " + code + "; inspect standard status and recover/reset the exact verify run")
            if current.get("status") == "completed":
                backup = current.get("artifacts", {}).get("final", {})
                if backup.get("label") != "restore-proven" or not re.fullmatch(r"[a-f0-9]{64}", backup.get("sha256", "")):
                    refuse("METAL_VERIFY_NOT_RESTORE_PROVEN", "inspect final backup manifest; no acceptance claimed")
                print(canonical({"code": "METAL_VERIFY_OK", "workspace": ws, "run_id": runid, "backup_sha256": backup["sha256"]}))
                if not keep:
                    control(["standard", "run", "reset", ws, runid, "--yes"])
                return
            time.sleep(5)
        refuse("METAL_VERIFY_TIMEOUT", "inspect status; recover/reset the exact verify workspace before retry")
    except (Refusal, KeyError):
        print("METAL_VERIFY_FAILED: workspace=" + ws + " run=" + (runid or "not-started") + "; inspect standard status, recover/reset exact run (evidence/backups retained)", file=sys.stderr)
        raise

def status():
    manifest = load(P/"state/install-manifest.json") if (P/"state/install-manifest.json").exists() else None
    active = []
    for path in W.glob("*/.silo-migrate/named/standard/state.json"):
        state = load(path)
        for runid, state_run in state.get("runs", {}).items():
            if state_run.get("status") in ("claimed", "running"):
                active.append({"workspace": path.parents[3].name, "run_id": runid, "status": state_run["status"]})
    image_state = "not-installed"
    if manifest:
        image_state = manifest.get("image_verification", "unknown")
        if image_state == "verified":
            identity = module("image_identity", "image_identity.py")
            for image in manifest.get("images", []):
                inspected = output(["docker", "image", "inspect", image.get("resolved_ref", image["ref"])], account=True)
                if not inspected or identity.content_id(json.loads(inspected)) != image["content_id"]:
                    image_state = "mismatch-or-unavailable"
                    break
    result = {"manifest": manifest, "current": str((P/"current").resolve()) if (P/"current").is_symlink() else None,
              "previous": str((P/"previous").resolve()) if (P/"previous").is_symlink() else None, "active_runs": active,
              "workspace_disk_use": output(["du", "-sx", "--block-size=1", W]),
              "term_llm_version": output([P/"bin/term-llm", "--version"], account=True) if account_entry() else None,
              "service_state": output(["systemctl", "--user", "is-active", "term-llm-web.service"], account=True) if account_entry() else None,
              "image_verification": image_state}
    print(json.dumps(result, indent=2, sort_keys=True))

def main():
    global C, P, W
    parser = argparse.ArgumentParser(description="Debian 12/amd64 single-account installer; no host Ruby/Node/compiler")
    parser.add_argument("command", choices=("preflight", "plan", "apply", "verify", "update", "status", "rollback", "artifacts", "_account-apply", "_account-update", "_account-rollback", "_locked-apply"))
    parser.add_argument("extra", nargs="*")
    parser.add_argument("--config")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--allow-untested-os", action="store_true")
    parser.add_argument("--plan", help="plan output path, or approved plan input for apply")
    parser.add_argument("--branch")
    parser.add_argument("--keep", action="store_true")
    parser.add_argument("--term-llm", action="store_true", help="also switch retained term-llm version during rollback (does not restart service)")
    args = parser.parse_args()
    C = read_config(args.config)
    if args.branch:
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_./-]*", args.branch) or ".." in args.branch:
            refuse("METAL_CONFIG_INVALID", "invalid update branch")
    P, W = Path(C["SILO_PREFIX"]), Path(C["SILO_WORKSPACES"])
    if args.command == "artifacts":
        if len(args.extra) != 2 or args.extra[0] != "verify":
            parser.error("artifacts verify DIR")
        module("package_artifacts", "package-artifacts").verify(args.extra[1])
        print("ARTIFACTS_OK")
    elif args.extra:
        parser.error("unexpected positional arguments")
    elif args.command == "preflight":
        result = preflight(args.allow_untested_os)
        if args.json:
            print(json.dumps(result, indent=2, sort_keys=True))
        else:
            print("Preflight (read-only; no sudo, no containers stopped)")
            for key, value in result.items():
                print(key + ": " + json.dumps(value, sort_keys=True))
        if result["errors"]:
            return 1
    elif args.command == "plan":
        plan = envelope(computed_plan(args))
        if args.json:
            print(json.dumps(plan, sort_keys=True, indent=2))
        else:
            for section in ("needs_root", "as_account"):
                print("Needs root" if section == "needs_root" else "As " + C["SILO_ACCOUNT"])
                for i, action in enumerate(plan["plan"][section], 1):
                    print(str(i) + ". " + action["detail"] + (" " + action["path"] if "path" in action else "") + (" " + shlex.join(action["argv"]) if "argv" in action else ""))
            print("Directory authority (all ancestors, bound into plan SHA):")
            for path, state in plan["plan"]["state"]["directory_authority"].items():
                print(path + " " + canonical(state))
            print("\n".join(plan["plan"]["notes"]))
            print("Plan SHA256: " + plan["sha256"])
        if args.plan:
            # Explicit output is the only filesystem write made by plan.
            fd = os.open(args.plan, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd, "w") as stream:
                json.dump(plan, stream, indent=2, sort_keys=True)
                stream.write("\n")
    elif args.command in ("apply", "_locked-apply"):
        if not args.plan:
            parser.error("apply requires --plan FILE")
        saved = load(args.plan)
        verify_installer(saved["plan"])
        current = envelope(computed_plan(args))
        if saved != current:
            refuse("METAL_PLAN_STALE", "plan SHA/state differs; review a freshly generated plan")
        if not current["plan"]["needs_root"] and not current["plan"]["as_account"]:
            print("METAL_UNCHANGED: no writes")
            return 0
        if args.command == "apply" and os.geteuid() != 0:
            opts = (["--config", str(Path(args.config).resolve())] if args.config else []) + (["--allow-untested-os"] if args.allow_untested_os else [])
            result = run([SELF, "_locked-apply", "--plan", str(Path(args.plan).resolve())] + opts, root=True, timeout=7200)
            print(result.stdout.strip())
            return 0
        # Only the lock's missing parent directories precede serialization.
        # No account/package/service mutation occurs until install.lock is held.
        entry = account_entry()
        bootstrap = []
        for directory in (P, P/"state", P/"state/tmp"):
            if not directory.exists():
                secure_directory(directory, entry.pw_uid if entry else 0, entry.pw_gid if entry else 0)
                bootstrap.append(directory)
        with install_lock():
            if not entry:
                run(["useradd", "--create-home", "--home-dir", "/home/" + C["SILO_ACCOUNT"], "--shell", "/bin/bash", C["SILO_ACCOUNT"]], root=True)
                entry = account_entry()
                for directory in bootstrap:
                    fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
                    try:
                        if os.fstat(fd).st_uid != 0:
                            refuse("METAL_PATH_AUTHORITY", "bootstrap directory ownership changed")
                        os.fchown(fd, entry.pw_uid, entry.pw_gid)
                    finally:
                        os.close(fd)
                os.chown(P/"state/install.lock", entry.pw_uid, entry.pw_gid, follow_symlinks=False)
            # Recheck authority and installer after acquiring serialization.
            directory_authority([P, W, home()])
            verify_installer(saved["plan"])
            locked = make_plan(args.allow_untested_os)
            expected_state = {k:v for k,v in saved["plan"]["state"].items() if k != "directory_authority"}
            observed_state = {k:v for k,v in locked["state"].items() if k != "directory_authority"}
            if locked["target"] != saved["plan"]["target"] or expected_state != observed_state:
                refuse("METAL_PLAN_STALE", "installation changed before lock acquisition; re-plan")
            verify_installer(saved["plan"])
            apply_roots([a for a in current["plan"]["needs_root"] if a["action"] != "account"])
            if current["plan"]["as_account"]:
                confargs = ["--config", str(Path(args.config).resolve())] if args.config else []
                run([SELF, "_account-apply"] + confargs, account=True, input=canonical(saved), timeout=7200)
        print("METAL_APPLY_OK")
    elif args.command == "_account-apply":
        saved = json.load(sys.stdin)
        if saved != envelope(saved["plan"]) or saved["plan"]["config"] != C:
            refuse("METAL_PLAN_STALE", "internal plan/config mismatch")
        verify_installer(saved["plan"])
        if (P/"state/install-manifest.json").exists():
            with idle_guard():
                account_apply(saved)
        else:
            account_apply(saved)
    elif args.command in ("update", "rollback"):
        confargs = ["--config", str(Path(args.config).resolve())] if args.config else []
        opts = (["--branch", args.branch] if args.branch else []) + (["--term-llm"] if args.term_llm else [])
        result = run([SELF, "_account-" + args.command] + confargs + opts, account=True, timeout=900)
        print(result.stdout.strip())
    elif args.command in ("_account-update", "_account-rollback"):
        if os.geteuid() != pwd.getpwnam(C["SILO_ACCOUNT"]).pw_uid:
            refuse("METAL_ACCOUNT_REQUIRED", "run update/rollback through service account")
        with install_lock():
            account_update(args.command == "_account-rollback", args.branch, args.term_llm)
    elif args.command == "verify":
        entry = account_entry()
        if entry and os.geteuid() not in (0, entry.pw_uid):
            opts = (["--config", str(Path(args.config).resolve())] if args.config else []) + (["--keep"] if args.keep else [])
            print(run([SELF, "verify"] + opts, account=True, timeout=7200, relay=True).stdout.strip())
        else:
            verify(args.keep)
    elif args.command == "status":
        entry = account_entry()
        if entry and os.geteuid() not in (0, entry.pw_uid):
            opts = ["--config", str(Path(args.config).resolve())] if args.config else []
            print(run([SELF, "status"] + opts, account=True).stdout.strip())
        else:
            status()
    return 0

if __name__ == "__main__":
    try:
        sys.exit(main())
    except Refusal as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(1)
    except (OSError, ValueError, TypeError, AttributeError, KeyError, AssertionError, tarfile.TarError):
        print("METAL_" + STAGE + "_STATE_INVALID: invalid/unavailable local state; inspect locally and re-plan (raw errors suppressed)", file=sys.stderr)
        sys.exit(1)
