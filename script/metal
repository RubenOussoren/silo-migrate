#!/usr/bin/env bash
# Bash entry point; isolated Python stdlib engine keeps JSON/config parsing out of eval.
set -euo pipefail
# Read the engine through a pipe. A here-document larger than the pipe buffer
# is spooled by bash to $TMPDIR, which for account steps is managed state.
engine=$(sed -e '1,/^: <<.PYTHON.$/d' -e '/^PYTHON$/,$d' "$0")
[ -n "$engine" ] || { echo 'METAL_INSTALLER_INCOMPLETE: engine unreadable' >&2; exit 70; }
exec python3 -I -c "$engine" "$0" "$@"
: <<'PYTHON'
